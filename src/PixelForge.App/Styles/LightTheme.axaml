<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Light Theme Semantic Colors -->
    <Color x:Key="SurfaceBaseColor">#F1F5F9</Color>
    <Color x:Key="SurfacePanelColor">#FFFFFF</Color>
    <Color x:Key="SurfaceCardColor">#F8FAFC</Color>
    <Color x:Key="SurfaceCardHoverColor">#E2E8F0</Color>
    <Color x:Key="SurfaceCardSelectedColor">#CBD5E1</Color>
    <Color x:Key="SurfaceInputColor">#FFFFFF</Color>
    <Color x:Key="SurfaceBadgeColor">#E2E8F0</Color>
    <Color x:Key="SurfaceChipColor">#EEF2F6</Color>

    <Color x:Key="BorderSubtleColor">#E2E8F0</Color>
    <Color x:Key="BorderStrongColor">#CBD5E1</Color>

    <Color x:Key="TextPrimaryColor">#0F172A</Color>
    <Color x:Key="TextSecondaryColor">#475569</Color>
    <Color x:Key="TextMutedColor">#64748B</Color>
    <Color x:Key="TextBadgeColor">#334155</Color>

    <Color x:Key="AccentPrimaryColor">#0284C7</Color>
    <Color x:Key="AccentPrimaryHoverColor">#0369A1</Color>
    <Color x:Key="AccentSecondaryColor">#6366F1</Color>
    <Color x:Key="AccentSuccessColor">#059669</Color>
    <Color x:Key="AccentDangerColor">#DC2626</Color>
    <Color x:Key="AccentWarningColor">#D97706</Color>
    <Color x:Key="AccentGlowColor">#330284C7</Color>

    <Color x:Key="CheckerLightColor">#FFFFFF</Color>
    <Color x:Key="CheckerDarkColor">#E2E8F0</Color>

    <!-- SolidColorBrushes -->
    <SolidColorBrush x:Key="SurfaceBaseBrush" Color="{StaticResource SurfaceBaseColor}" />
    <SolidColorBrush x:Key="SurfacePanelBrush" Color="{StaticResource SurfacePanelColor}" />
    <SolidColorBrush x:Key="SurfaceCardBrush" Color="{StaticResource SurfaceCardColor}" />
    <SolidColorBrush x:Key="SurfaceCardHoverBrush" Color="{StaticResource SurfaceCardHoverColor}" />
    <SolidColorBrush x:Key="SurfaceCardSelectedBrush" Color="{StaticResource SurfaceCardSelectedColor}" />
    <SolidColorBrush x:Key="SurfaceInputBrush" Color="{StaticResource SurfaceInputColor}" />
    <SolidColorBrush x:Key="SurfaceBadgeBrush" Color="{StaticResource SurfaceBadgeColor}" />
    <SolidColorBrush x:Key="SurfaceChipBrush" Color="{StaticResource SurfaceChipColor}" />

    <SolidColorBrush x:Key="BorderSubtleBrush" Color="{StaticResource BorderSubtleColor}" />
    <SolidColorBrush x:Key="BorderStrongBrush" Color="{StaticResource BorderStrongColor}" />

    <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextPrimaryColor}" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondaryColor}" />
    <SolidColorBrush x:Key="TextMutedBrush" Color="{StaticResource TextMutedColor}" />
    <SolidColorBrush x:Key="TextBadgeBrush" Color="{StaticResource TextBadgeColor}" />

    <SolidColorBrush x:Key="AccentPrimaryBrush" Color="{StaticResource AccentPrimaryColor}" />
    <SolidColorBrush x:Key="AccentPrimaryHoverBrush" Color="{StaticResource AccentPrimaryHoverColor}" />
    <SolidColorBrush x:Key="AccentSecondaryBrush" Color="{StaticResource AccentSecondaryColor}" />
    <SolidColorBrush x:Key="AccentSuccessBrush" Color="{StaticResource AccentSuccessColor}" />
    <SolidColorBrush x:Key="AccentDangerBrush" Color="{StaticResource AccentDangerColor}" />
    <SolidColorBrush x:Key="AccentWarningBrush" Color="{StaticResource AccentWarningColor}" />
    <SolidColorBrush x:Key="AccentGlowBrush" Color="{StaticResource AccentGlowColor}" />

    <SolidColorBrush x:Key="CheckerLightBrush" Color="{StaticResource CheckerLightColor}" />
    <SolidColorBrush x:Key="CheckerDarkBrush" Color="{StaticResource CheckerDarkColor}" />

</ResourceDictionary>
