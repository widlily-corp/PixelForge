<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="580" d:DesignHeight="520"
        x:Class="PixelForge.App.Views.ColorRampDialog"
        Title="{Binding Loc[Dlg_RampTitle]}"
        Width="580" Height="520"
        MinWidth="520" MinHeight="480"
        WindowStartupLocation="CenterOwner"
        CanResize="False"
        Background="{DynamicResource SurfaceBaseBrush}">

    <Border Padding="20">
        <Grid RowDefinitions="Auto,Auto,*,Auto">
            <!-- Header -->
            <Grid Grid.Row="0" ColumnDefinitions="Auto,*" Margin="0,0,0,16">
                <Border Grid.Column="0" Width="36" Height="36" CornerRadius="8"
                        Background="{DynamicResource SurfaceCardBrush}"
                        BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1"
                        Margin="0,0,12,0">
                    <PathIcon Data="{DynamicResource IconGradient}" Width="18" Height="18"
                              Foreground="{DynamicResource AccentPrimaryBrush}"
                              HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                    <TextBlock Text="{Binding Loc[Dlg_RampHeader]}" FontSize="14" FontWeight="Bold"
                               Foreground="{DynamicResource TextPrimaryBrush}" LetterSpacing="0.5" />
                    <TextBlock Text="{Binding Loc[Dlg_RampSubheader]}"
                               FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" />
                </StackPanel>
            </Grid>

            <!-- Parameters Card -->
            <Border Grid.Row="1" Background="{DynamicResource SurfaceCardBrush}"
                    BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1"
                    CornerRadius="8" Padding="14" Margin="0,0,0,14">
                <StackPanel Spacing="12">
                    <!-- Base Color Picker Row -->
                    <Grid ColumnDefinitions="Auto,Auto,*,Auto">
                        <TextBlock Grid.Column="0" Text="{Binding Loc[Dlg_RampBaseColor]}" FontSize="12" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,12,0" />
                        <Border Name="BaseColorSwatch" Grid.Column="1" Width="32" Height="32"
                                Background="#E65100" CornerRadius="6"
                                BorderBrush="{DynamicResource BorderStrongBrush}" BorderThickness="1.5"
                                BoxShadow="0 2 6 0 #30000000" VerticalAlignment="Center" Margin="0,0,12,0" />
                        <Button Name="UsePrimaryColorButton" Grid.Column="3" Classes="action-btn"
                                Padding="10,6" CornerRadius="6" Background="{DynamicResource SurfacePanelBrush}"
                                BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1"
                                ToolTip.Tip="{Binding Loc[Dlg_RampUsePrimaryTip]}">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <PathIcon Data="{DynamicResource IconPalette}" Width="12" Height="12" Foreground="{DynamicResource AccentPrimaryBrush}" />
                                <TextBlock Text="{Binding Loc[Dlg_RampUsePrimary]}" FontSize="11" Foreground="{DynamicResource TextPrimaryBrush}" />
                            </StackPanel>
                        </Button>
                    </Grid>

                    <Separator Height="1" Background="{DynamicResource BorderSubtleBrush}" />

                    <!-- Preset Selector Row -->
                    <Grid ColumnDefinitions="140,*">
                        <TextBlock Grid.Column="0" Text="{Binding Loc[Dlg_RampPreset]}" FontSize="12"
                                   Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" />
                        <ComboBox Name="PresetComboBox" Grid.Column="1" Height="30" FontSize="12"
                                  HorizontalAlignment="Stretch" VerticalContentAlignment="Center">
                            <ComboBoxItem Content="{Binding Loc[Dlg_RampPreset_Sunlight]}" IsSelected="True" />
                            <ComboBoxItem Content="{Binding Loc[Dlg_RampPreset_Fire]}" />
                            <ComboBoxItem Content="{Binding Loc[Dlg_RampPreset_Ice]}" />
                            <ComboBoxItem Content="{Binding Loc[Dlg_RampPreset_Toxic]}" />
                            <ComboBoxItem Content="{Binding Loc[Dlg_RampPreset_Gold]}" />
                            <ComboBoxItem Content="{Binding Loc[Dlg_RampPreset_Custom]}" />
                        </ComboBox>
                    </Grid>

                    <!-- Steps Slider Row -->
                    <Grid ColumnDefinitions="140,*,60">
                        <TextBlock Grid.Column="0" Text="{Binding Loc[Dlg_RampSteps]}" FontSize="12"
                                   Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" />
                        <Slider Name="StepsSlider" Grid.Column="1" Minimum="3" Maximum="12" Value="5"
                                SmallChange="1" LargeChange="1" VerticalAlignment="Center" Margin="0,0,10,0" />
                        <Border Grid.Column="2" Background="{DynamicResource SurfacePanelBrush}"
                                BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1"
                                CornerRadius="4" Padding="6,2" HorizontalAlignment="Center">
                            <TextBlock Name="StepsValueText" Text="5" FontSize="12" FontWeight="Bold"
                                       Foreground="{DynamicResource AccentPrimaryBrush}" TextAlignment="Center" />
                        </Border>
                    </Grid>

                    <!-- Hue Shift Angle Slider Row -->
                    <Grid ColumnDefinitions="140,*,60">
                        <TextBlock Grid.Column="0" Text="{Binding Loc[Dlg_RampHueShift]}" FontSize="12"
                                   Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" />
                        <Slider Name="HueShiftSlider" Grid.Column="1" Minimum="-60" Maximum="60" Value="30"
                                SmallChange="5" LargeChange="10" VerticalAlignment="Center" Margin="0,0,10,0" />
                        <Border Grid.Column="2" Background="{DynamicResource SurfacePanelBrush}"
                                BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1"
                                CornerRadius="4" Padding="6,2" HorizontalAlignment="Center">
                            <TextBlock Name="HueShiftValueText" Text="+30°" FontSize="12" FontWeight="Bold"
                                       Foreground="{DynamicResource AccentSecondaryBrush}" TextAlignment="Center" />
                        </Border>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Live Preview Swatches Card -->
            <Border Grid.Row="2" Background="{DynamicResource SurfaceCardBrush}"
                    BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1"
                    CornerRadius="8" Padding="14" Margin="0,0,0,16">
                <Grid RowDefinitions="Auto,*">
                    <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,10">
                        <TextBlock Grid.Column="0" Text="{Binding Loc[Dlg_RampPreview]}" FontSize="11" FontWeight="Bold"
                                   Foreground="{DynamicResource TextMutedBrush}" LetterSpacing="0.8" />
                        <TextBlock Name="RampStatusText" Grid.Column="1" Text="5" FontSize="11"
                                   Foreground="{DynamicResource AccentPrimaryBrush}" />
                    </Grid>

                    <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                        <StackPanel Name="SwatchesContainer" Orientation="Horizontal" Spacing="8"
                                    HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </ScrollViewer>
                </Grid>
            </Border>

            <!-- Footer Action Buttons -->
            <Grid Grid.Row="3" ColumnDefinitions="Auto,*,Auto,8,Auto">
                <Button Name="AddToPaletteButton" Grid.Column="0" Classes="action-btn"
                        Padding="14,8" CornerRadius="6"
                        Background="{DynamicResource SurfacePanelBrush}"
                        BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <PathIcon Data="{DynamicResource IconPalette}" Width="14" Height="14" Foreground="{DynamicResource AccentPrimaryBrush}" />
                        <TextBlock Text="{Binding Loc[Dlg_RampApplyToPalette]}" FontSize="12" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimaryBrush}" />
                    </StackPanel>
                </Button>

                <Button Name="ApplyToGradientButton" Grid.Column="2"
                        Padding="16,8" CornerRadius="6"
                        Background="{DynamicResource AccentPrimaryBrush}"
                        BorderBrush="{DynamicResource AccentPrimaryHoverBrush}" BorderThickness="1"
                        Cursor="Hand">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <PathIcon Data="{DynamicResource IconGradient}" Width="14" Height="14" Foreground="#0A0E17" />
                        <TextBlock Text="{Binding Loc[Dlg_RampApplyToGradient]}" FontSize="12" FontWeight="Bold"
                                   Foreground="#0A0E17" />
                    </StackPanel>
                </Button>

                <Button Name="CloseButton" Grid.Column="4" Content="{Binding Loc[Dlg_RampClose]}"
                        Padding="16,8" CornerRadius="6" FontSize="12"
                        Background="{DynamicResource SurfaceCardBrush}"
                        BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1"
                        Foreground="{DynamicResource TextSecondaryBrush}" />
            </Grid>
        </Grid>
    </Border>
</Window>
