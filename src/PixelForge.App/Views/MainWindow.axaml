<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:PixelForge.App.ViewModels"
        xmlns:models="using:PixelForge.Core.Models"
        xmlns:controls="using:PixelForge.App.Controls"
        xmlns:views="using:PixelForge.App.Views"
        mc:Ignorable="d" d:DesignWidth="1280" d:DesignHeight="800"
        x:Class="PixelForge.App.Views.MainWindow"
        x:Name="RootWindow"
        x:DataType="vm:MainViewModel"
        Title="{Binding Title, FallbackValue='PixelForge'}"
        Icon="/Assets/icon.ico"
        Width="1280" Height="800"
        MinWidth="1024" MinHeight="680"
        WindowStartupLocation="CenterScreen"
        Focusable="True"
        Background="{DynamicResource SurfaceBaseBrush}">

    <Window.Resources>
        <views:ToolToIconGeometryConverter x:Key="ToolToIconConverter" />
    </Window.Resources>

    <Window.Styles>
        <!-- Toolbar Tool Button Style -->
        <Style Selector="Button.tool-btn">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Width" Value="40" />
            <Setter Property="Height" Value="40" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="1.5" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="ToolTip.Placement" Value="Right" />
            <Setter Property="ToolTip.HorizontalOffset" Value="10" />
            <Setter Property="ToolTip.ShowDelay" Value="200" />
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.15" />
                    <BrushTransition Property="BorderBrush" Duration="0:0:0.15" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Button.tool-btn:pointerover">
            <Setter Property="Background" Value="{DynamicResource SurfaceCardHoverBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtleBrush}" />
        </Style>
        <Style Selector="Button.tool-btn.active">
            <Setter Property="Background" Value="{DynamicResource AccentGlowBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource AccentPrimaryBrush}" />
        </Style>
        <Style Selector="Button.tool-btn.active PathIcon">
            <Setter Property="Foreground" Value="{DynamicResource AccentPrimaryBrush}" />
        </Style>
        <Style Selector="Button.tool-btn:not(.active) PathIcon">
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
        </Style>
        <Style Selector="Button.tool-btn:not(.active):pointerover PathIcon">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        </Style>

        <!-- Stepper Size Buttons -->
        <Style Selector="Button.size-btn">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Width" Value="19" />
            <Setter Property="Height" Value="20" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Background" Value="{DynamicResource SurfacePanelBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtleBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.1" />
                    <BrushTransition Property="BorderBrush" Duration="0:0:0.1" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Button.size-btn:pointerover">
            <Setter Property="Background" Value="{DynamicResource SurfaceCardHoverBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource AccentPrimaryBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource AccentPrimaryBrush}" />
        </Style>

        <!-- Quick Size Preset Button Style -->
        <Style Selector="Button.size-preset-btn">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Width" Value="22" />
            <Setter Property="Height" Value="22" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="CornerRadius" Value="11" />
            <Setter Property="Background" Value="{DynamicResource SurfacePanelBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtleBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="FontSize" Value="10" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.1" />
                    <BrushTransition Property="BorderBrush" Duration="0:0:0.1" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Button.size-preset-btn:pointerover">
            <Setter Property="Background" Value="{DynamicResource SurfaceCardHoverBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource AccentPrimaryBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource AccentPrimaryBrush}" />
        </Style>

        <!-- Context Bar Chip / Capsule Border Style -->
        <Style Selector="Border.context-chip">
            <Setter Property="Background" Value="{DynamicResource SurfaceCardBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtleBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="8,3" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <!-- Context Bar ToggleButton Style -->
        <Style Selector="ToggleButton.context-toggle-btn">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Background" Value="{DynamicResource SurfacePanelBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtleBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.1" />
                    <BrushTransition Property="BorderBrush" Duration="0:0:0.1" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="ToggleButton.context-toggle-btn:pointerover">
            <Setter Property="Background" Value="{DynamicResource SurfaceCardHoverBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource AccentPrimaryBrush}" />
        </Style>
        <Style Selector="ToggleButton.context-toggle-btn:checked">
            <Setter Property="Background" Value="{DynamicResource AccentGlowBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource AccentPrimaryBrush}" />
        </Style>

        <!-- Status Bar Capsule Button Style -->
        <Style Selector="Button.status-capsule-btn">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="CornerRadius" Value="11" />
            <Setter Property="Background" Value="{DynamicResource SurfaceCardBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtleBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.1" />
                    <BrushTransition Property="BorderBrush" Duration="0:0:0.1" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Button.status-capsule-btn:pointerover">
            <Setter Property="Background" Value="{DynamicResource SurfaceCardHoverBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource AccentPrimaryBrush}" />
        </Style>

        <!-- Status Bar Capsule Badge Style -->
        <Style Selector="Border.status-capsule-badge">
            <Setter Property="CornerRadius" Value="11" />
            <Setter Property="Background" Value="{DynamicResource SurfaceCardBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtleBrush}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>

        <!-- Quick Action Icon Button Style -->
        <Style Selector="Button.action-btn">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Height" Value="30" />
            <Setter Property="Padding" Value="8,4" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="Button.action-btn:pointerover">
            <Setter Property="Background" Value="{DynamicResource SurfaceCardHoverBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtleBrush}" />
        </Style>
    </Window.Styles>

    <Grid RowDefinitions="Auto,Auto,Auto,*,Auto">
        <!-- 1. Top MenuBar -->
        <Border Grid.Row="0" Background="{DynamicResource SurfacePanelBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="0,0,0,1">
            <Menu Height="28">
                <!-- File Menu -->
                <MenuItem Header="Файл">
                    <MenuItem Name="MenuNew" Header="Новый холст..." HotKey="Ctrl+N" />
                    <MenuItem Header="Открыть проект..." HotKey="Ctrl+O" Command="{Binding OpenProjectCommand}" />
                    <MenuItem Header="Сохранить" HotKey="Ctrl+S" Command="{Binding SaveProjectCommand}" />
                    <MenuItem Header="Сохранить как..." HotKey="Ctrl+Shift+S" Command="{Binding SaveProjectAsCommand}" />
                    <Separator />
                    <MenuItem Header="Экспорт в PNG..." Command="{Binding ExportPngCommand}" />
                    <MenuItem Header="Экспорт в BMP..." Command="{Binding ExportBmpCommand}" />
                    <Separator />
                    <MenuItem Name="MenuExit" Header="Выход" HotKey="Alt+F4" />
                </MenuItem>

                <!-- Edit Menu -->
                <MenuItem Header="Правка">
                    <MenuItem Header="Отменить" HotKey="Ctrl+Z" Command="{Binding HistoryViewModel.UndoCommand}" />
                    <MenuItem Header="Повторить" HotKey="Ctrl+Y" Command="{Binding HistoryViewModel.RedoCommand}" />
                    <Separator />
                    <MenuItem Header="Вырезать" HotKey="Ctrl+X" Command="{Binding CutCommand}" />
                    <MenuItem Header="Копировать" HotKey="Ctrl+C" Command="{Binding CopyCommand}" />
                    <MenuItem Header="Вставить" HotKey="Ctrl+V" Command="{Binding PasteCommand}" />
                    <Separator />
                    <MenuItem Header="Выделить всё" HotKey="Ctrl+A" Command="{Binding SelectAllCommand}" />
                    <MenuItem Header="Снять выделение" HotKey="Ctrl+D" Command="{Binding DeselectCommand}" />
                    <MenuItem Header="Удалить выделение" HotKey="Delete" Command="{Binding DeleteSelectionOrClearLayerCommand}" />
                </MenuItem>

                <!-- Canvas Menu -->
                <MenuItem Header="Холст">
                    <MenuItem Name="MenuResizeCanvas" Header="Размер холста..." HotKey="Ctrl+Alt+C" />
                    <Separator />
                    <MenuItem Header="Трансформация слоя">
                        <MenuItem Header="Отразить по горизонтали (H)" Command="{Binding FlipActiveLayerHorizontalCommand}" />
                        <MenuItem Header="Отразить по вертикали (V)" Command="{Binding FlipActiveLayerVerticalCommand}" />
                        <Separator />
                        <MenuItem Header="Повернуть на 90° по часовой" Command="{Binding RotateActiveLayerCWCommand}" />
                        <MenuItem Header="Повернуть на 90° против часовой" Command="{Binding RotateActiveLayerCCWCommand}" />
                        <MenuItem Header="Повернуть на 180°" Command="{Binding RotateActiveLayer180Command}" />
                    </MenuItem>
                    <MenuItem Header="Трансформация холста">
                        <MenuItem Header="Отразить холст по горизонтали" Command="{Binding FlipCanvasHorizontalCommand}" />
                        <MenuItem Header="Отразить холст по вертикали" Command="{Binding FlipCanvasVerticalCommand}" />
                        <Separator />
                        <MenuItem Header="Повернуть холст на 90° по часовой" Command="{Binding RotateCanvasCWCommand}" />
                        <MenuItem Header="Повернуть холст на 90° против часовой" Command="{Binding RotateCanvasCCWCommand}" />
                        <MenuItem Header="Повернуть холст на 180°" Command="{Binding RotateCanvas180Command}" />
                    </MenuItem>
                    <Separator />
                    <MenuItem Header="Очистить активный слой" Command="{Binding ClearActiveLayerCommand}" />
                    <Separator />
                    <MenuItem Header="Смарт-инструменты">
                        <MenuItem Header="Добавить контур (Outline)..." Command="{Binding AddOutlineCommand}" />
                        <MenuItem Header="Добавить тень (Shadow)..." Command="{Binding AddShadowCommand}" />
                        <MenuItem Header="Заменить цвет (Replace Color)..." Command="{Binding ReplaceColorCommand}" />
                        <Separator />
                        <MenuItem Header="Генератор цветовой рампы (Color Ramp)..." Command="{Binding OpenColorRampDialogCommand}" />
                        <Separator />
                        <MenuItem Header="Бесшовный режим (Tiled Mode)" HotKey="F10" Command="{Binding ToggleTiledModeCommand}" />
                    </MenuItem>
                </MenuItem>

                <!-- View Menu -->
                <MenuItem Header="Вид">
                    <MenuItem Header="Пиксельная сетка" HotKey="Ctrl+G" Command="{Binding CanvasViewModel.ToggleGridCommand}" />
                    <MenuItem Header="Симметрия по горизонтали (X)" Command="{Binding CanvasViewModel.ToggleSymmetryXCommand}" />
                    <MenuItem Header="Симметрия по вертикали (Y)" Command="{Binding CanvasViewModel.ToggleSymmetryYCommand}" />
                    <MenuItem Header="Бесшовный режим (Tiled Mode)" HotKey="F10" Command="{Binding ToggleTiledModeCommand}" />
                    <Separator />
                    <MenuItem Header="Приблизить" HotKey="Ctrl+Add" Command="{Binding CanvasViewModel.ZoomInCommand}" />
                    <MenuItem Header="Отдалить" HotKey="Ctrl+Subtract" Command="{Binding CanvasViewModel.ZoomOutCommand}" />
                    <MenuItem Header="Сбросить масштаб (100%)" HotKey="Ctrl+D0" Command="{Binding CanvasViewModel.ResetZoomCommand}" />
                    <Separator />
                    <MenuItem Name="MenuToggleTheme" Header="Переключить тему (Тёмная/Светлая)" />
                </MenuItem>

                <!-- Help Menu -->
                <MenuItem Header="Справка">
                    <MenuItem Name="MenuHotkeys" Header="Горячие клавиши... (F1)" HotKey="F1" Command="{Binding OpenHotkeysDialogCommand}" />
                    <MenuItem Header="Проверить обновления..." Command="{Binding CheckForUpdatesCommand}" />
                    <Separator />
                    <MenuItem Name="MenuAbout" Header="О программе..." />
                </MenuItem>
            </Menu>
        </Border>

        <!-- 2. Quick Action Toolbar -->
        <Border Grid.Row="1" Background="{DynamicResource SurfaceCardBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="0,0,0,1" Padding="8,4">
            <Grid ColumnDefinitions="Auto,Auto,Auto,Auto,Auto,*,Auto">
                <!-- File Shortcuts -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="4">
                    <Button Name="QuickNewButton" Classes="action-btn" ToolTip.Tip="Новый холст (Ctrl+N)">
                        <PathIcon Data="{DynamicResource IconNewFile}" Width="16" Height="16" Foreground="{DynamicResource TextPrimaryBrush}" />
                    </Button>
                    <Button Name="QuickResizeButton" Classes="action-btn" ToolTip.Tip="Изменить размер холста (Ctrl+Alt+C)">
                        <PathIcon Data="{DynamicResource IconCrop}" Width="16" Height="16" Foreground="{DynamicResource TextPrimaryBrush}" />
                    </Button>
                    <Button Classes="action-btn" Command="{Binding OpenProjectCommand}" ToolTip.Tip="Открыть проект (Ctrl+O)">
                        <PathIcon Data="{DynamicResource IconFolderOpen}" Width="16" Height="16" Foreground="{DynamicResource TextPrimaryBrush}" />
                    </Button>
                    <Button Classes="action-btn" Command="{Binding SaveProjectCommand}" ToolTip.Tip="Сохранить проект (Ctrl+S)">
                        <PathIcon Data="{DynamicResource IconSave}" Width="16" Height="16" Foreground="{DynamicResource TextPrimaryBrush}" />
                    </Button>
                </StackPanel>

                <Separator Grid.Column="1" Width="1" Height="20" Margin="8,0" Background="{DynamicResource BorderSubtleBrush}" />

                <!-- History (Undo/Redo) -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4">
                    <Button Classes="action-btn" Command="{Binding HistoryViewModel.UndoCommand}" ToolTip.Tip="Отменить (Ctrl+Z)">
                        <PathIcon Data="{DynamicResource IconUndo}" Width="16" Height="16" Foreground="{DynamicResource TextPrimaryBrush}" />
                    </Button>
                    <Button Classes="action-btn" Command="{Binding HistoryViewModel.RedoCommand}" ToolTip.Tip="Повторить (Ctrl+Y)">
                        <PathIcon Data="{DynamicResource IconRedo}" Width="16" Height="16" Foreground="{DynamicResource TextPrimaryBrush}" />
                    </Button>
                </StackPanel>

                <Separator Grid.Column="3" Width="1" Height="20" Margin="8,0" Background="{DynamicResource BorderSubtleBrush}" />

                <!-- Overlays: Grid & Symmetry & Tiled Mode -->
                <StackPanel Grid.Column="4" Orientation="Horizontal" Spacing="4">
                    <ToggleButton Name="GridToggle" IsChecked="{Binding CanvasViewModel.ShowGrid, Mode=TwoWay}"
                                  Height="30" Padding="8,4" CornerRadius="4"
                                  ToolTip.Tip="Пиксельная сетка (Ctrl+G)">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <PathIcon Data="{DynamicResource IconGrid}" Width="14" Height="14" />
                            <TextBlock Text="Сетка" FontSize="11" VerticalAlignment="Center" />
                        </StackPanel>
                    </ToggleButton>

                    <ToggleButton Name="SymXToggle" IsChecked="{Binding CanvasViewModel.ShowSymmetryX, Mode=TwoWay}"
                                  Height="30" Padding="8,4" CornerRadius="4"
                                  ToolTip.Tip="Симметрия X (зеркало по горизонтали)">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <PathIcon Data="{DynamicResource IconSymmetryX}" Width="14" Height="14" />
                            <TextBlock Text="Симм. X" FontSize="11" VerticalAlignment="Center" />
                        </StackPanel>
                    </ToggleButton>

                    <ToggleButton Name="SymYToggle" IsChecked="{Binding CanvasViewModel.ShowSymmetryY, Mode=TwoWay}"
                                  Height="30" Padding="8,4" CornerRadius="4"
                                  ToolTip.Tip="Симметрия Y (зеркало по вертикали)">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <PathIcon Data="{DynamicResource IconSymmetryY}" Width="14" Height="14" />
                            <TextBlock Text="Симм. Y" FontSize="11" VerticalAlignment="Center" />
                        </StackPanel>
                    </ToggleButton>

                    <ToggleButton Name="TiledToggle" IsChecked="{Binding IsTiledMode, Mode=TwoWay}"
                                  Height="30" Padding="8,4" CornerRadius="4"
                                  ToolTip.Tip="Бесшовный режим (Tiled Mode) (F10)">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <PathIcon Data="{DynamicResource IconTiled}" Width="14" Height="14" />
                            <TextBlock Text="Тайлы" FontSize="11" VerticalAlignment="Center" />
                        </StackPanel>
                    </ToggleButton>
                </StackPanel>

                <!-- Zoom Controls & Theme Toggle -->
                <StackPanel Grid.Column="6" Orientation="Horizontal" Spacing="4">
                    <Button Classes="action-btn" Command="{Binding CanvasViewModel.ZoomOutCommand}" ToolTip.Tip="Отдалить (Ctrl+-)">
                        <PathIcon Data="{DynamicResource IconZoomOut}" Width="14" Height="14" Foreground="{DynamicResource TextPrimaryBrush}" />
                    </Button>
                    <TextBlock Text="{Binding CanvasViewModel.ZoomText}" Width="48" TextAlignment="Center"
                               VerticalAlignment="Center" FontSize="11" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextSecondaryBrush}" />
                    <Button Classes="action-btn" Command="{Binding CanvasViewModel.ZoomInCommand}" ToolTip.Tip="Приблизить (Ctrl++)">
                        <PathIcon Data="{DynamicResource IconZoomIn}" Width="14" Height="14" Foreground="{DynamicResource TextPrimaryBrush}" />
                    </Button>
                    <Button Classes="action-btn" Command="{Binding CanvasViewModel.ResetZoomCommand}" ToolTip.Tip="100% масштаб">
                        <PathIcon Data="{DynamicResource IconZoomFit}" Width="14" Height="14" Foreground="{DynamicResource TextPrimaryBrush}" />
                    </Button>

                    <Separator Width="1" Height="20" Margin="4,0" Background="{DynamicResource BorderSubtleBrush}" />

                    <Button Name="QuickThemeButton" Classes="action-btn" ToolTip.Tip="Переключить тему оформления">
                        <PathIcon Data="{DynamicResource IconTheme}" Width="14" Height="14" Foreground="{DynamicResource AccentPrimaryBrush}" />
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 3. Update Banner Notification (if update is available) -->
        <Border Grid.Row="2" Background="{DynamicResource AccentPrimaryBrush}" Padding="12,6"
                IsVisible="{Binding IsUpdateBannerVisible}">
            <Grid ColumnDefinitions="*,Auto,Auto,Auto">
                <StackPanel Grid.Column="0" Orientation="Vertical" VerticalAlignment="Center" Spacing="2">
                    <TextBlock Text="{Binding UpdateBannerMessage}"
                               VerticalAlignment="Center" FontSize="12" FontWeight="SemiBold" Foreground="#0A0E17" />
                    <ProgressBar Minimum="0" Maximum="100" Value="{Binding UpdateProgress}"
                                 Height="4" Foreground="#0A0E17" Background="#400A0E17"
                                 IsVisible="{Binding IsUpdating}" />
                    <TextBlock Text="{Binding UpdateStatusText}" FontSize="10" Foreground="#0A0E17"
                               IsVisible="{Binding IsUpdating}" />
                </StackPanel>
                <Button Grid.Column="1" Content="Обновить сейчас" Margin="8,0" Padding="12,4" CornerRadius="4"
                        Background="#0A0E17" Foreground="#FFFFFF" FontSize="11" FontWeight="Bold"
                        Command="{Binding ApplyUpdateCommand}" IsEnabled="{Binding !IsUpdating}"
                        ToolTip.Tip="Автоматически скачать, установить и перезапустить PixelForge" />
                <Button Grid.Column="2" Content="Сайт" Margin="0,0,8,0" Padding="8,4" CornerRadius="4"
                        Background="Transparent" BorderBrush="#0A0E17" BorderThickness="1" Foreground="#0A0E17" FontSize="11"
                        Command="{Binding OpenUpdateDownloadPageCommand}" IsEnabled="{Binding !IsUpdating}" />
                <Button Grid.Column="3" Content="✕" Padding="6,4" CornerRadius="4"
                        Background="Transparent" Foreground="#0A0E17" FontSize="12" FontWeight="Bold"
                        Command="{Binding DismissUpdateBannerCommand}" IsEnabled="{Binding !IsUpdating}" />
            </Grid>
        </Border>

        <!-- 4. Three-Column Workspace Area -->
        <Grid Grid.Row="3" ColumnDefinitions="58,*,310">
            <!-- Left: Tools Palette Column -->
            <Border Grid.Column="0" Background="{DynamicResource SurfacePanelBrush}"
                    BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="0,0,1,0"
                    Padding="5,8"
                    BoxShadow="1 0 6 0 #10000000">
                <Grid RowDefinitions="*,Auto">
                    <!-- Tools List grouped into 4 logical sections with ScrollViewer for all resolutions -->
                    <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Spacing="3" HorizontalAlignment="Center">
                            <!-- 1. РИСОВАНИЕ -->
                            <Border Background="{DynamicResource SurfaceChipBrush}" CornerRadius="3"
                                    Padding="4,1" Margin="0,2,0,2" HorizontalAlignment="Center"
                                    ToolTip.Tip="Инструменты свободного рисования">
                                <TextBlock Text="РИСОВАНИЕ" FontSize="7" FontWeight="Bold"
                                           Foreground="{DynamicResource TextMutedBrush}" LetterSpacing="0.5" />
                            </Border>

                            <Button Name="ToolPencilButton" Classes="tool-btn"
                                    ToolTip.Tip="Карандаш (B)">
                                <PathIcon Data="{DynamicResource IconPencil}" Width="18" Height="18" />
                            </Button>

                            <Button Name="ToolEraserButton" Classes="tool-btn"
                                    ToolTip.Tip="Ластик (E)">
                                <PathIcon Data="{DynamicResource IconEraser}" Width="18" Height="18" />
                            </Button>

                            <Button Name="ToolDitherButton" Classes="tool-btn"
                                    ToolTip.Tip="Дизеринг кисть (D)">
                                <PathIcon Data="{DynamicResource IconDither}" Width="18" Height="18" />
                            </Button>

                            <Button Name="ToolPatternBrushButton" Classes="tool-btn"
                                    ToolTip.Tip="Текстурная кисть 8x8 (P)">
                                <PathIcon Data="{DynamicResource IconPatternBrush}" Width="18" Height="18" />
                            </Button>

                            <Separator Height="1" Margin="4,4" Background="{DynamicResource BorderSubtleBrush}" />

                            <!-- 2. ЗАЛИВКА И ЦВЕТ -->
                            <Border Background="{DynamicResource SurfaceChipBrush}" CornerRadius="3"
                                    Padding="4,1" Margin="0,1,0,2" HorizontalAlignment="Center"
                                    ToolTip.Tip="Инструменты заливки и выбора цвета">
                                <TextBlock Text="ЗАЛИВКА" FontSize="7" FontWeight="Bold"
                                           Foreground="{DynamicResource TextMutedBrush}" LetterSpacing="0.5" />
                            </Border>

                            <Button Name="ToolFillButton" Classes="tool-btn"
                                    ToolTip.Tip="Заливка (G)">
                                <PathIcon Data="{DynamicResource IconFill}" Width="18" Height="18" />
                            </Button>

                            <Button Name="ToolMagicWandButton" Classes="tool-btn"
                                    ToolTip.Tip="Волшебная палочка (W)">
                                <PathIcon Data="{DynamicResource IconMagicWand}" Width="18" Height="18" />
                            </Button>

                            <Button Name="ToolGradientButton" Classes="tool-btn"
                                    ToolTip.Tip="Градиент (T)">
                                <PathIcon Data="{DynamicResource IconGradient}" Width="18" Height="18" />
                            </Button>

                            <Button Name="ToolEyedropperButton" Classes="tool-btn"
                                    ToolTip.Tip="Пипетка (I)">
                                <PathIcon Data="{DynamicResource IconEyedropper}" Width="18" Height="18" />
                            </Button>

                            <Separator Height="1" Margin="4,4" Background="{DynamicResource BorderSubtleBrush}" />

                            <!-- 3. ФИГУРЫ -->
                            <Border Background="{DynamicResource SurfaceChipBrush}" CornerRadius="3"
                                    Padding="4,1" Margin="0,1,0,2" HorizontalAlignment="Center"
                                    ToolTip.Tip="Геометрические фигуры">
                                <TextBlock Text="ФИГУРЫ" FontSize="7" FontWeight="Bold"
                                           Foreground="{DynamicResource TextMutedBrush}" LetterSpacing="0.5" />
                            </Border>

                            <Button Name="ToolLineButton" Classes="tool-btn"
                                    ToolTip.Tip="Линия (L)">
                                <PathIcon Data="{DynamicResource IconLine}" Width="18" Height="18" />
                            </Button>

                            <Button Name="ToolRectangleButton" Classes="tool-btn"
                                    ToolTip.Tip="Прямоугольник (R / U)">
                                <PathIcon Data="{DynamicResource IconRectangle}" Width="18" Height="18" />
                            </Button>

                            <Button Name="ToolEllipseButton" Classes="tool-btn"
                                    ToolTip.Tip="Эллипс (C)">
                                <PathIcon Data="{DynamicResource IconEllipse}" Width="18" Height="18" />
                            </Button>

                            <Separator Height="1" Margin="4,4" Background="{DynamicResource BorderSubtleBrush}" />

                            <!-- 4. ВЫДЕЛЕНИЕ -->
                            <Border Background="{DynamicResource SurfaceChipBrush}" CornerRadius="3"
                                    Padding="4,1" Margin="0,1,0,2" HorizontalAlignment="Center"
                                    ToolTip.Tip="Выделение области">
                                <TextBlock Text="ВЫБОР" FontSize="7" FontWeight="Bold"
                                           Foreground="{DynamicResource TextMutedBrush}" LetterSpacing="0.5" />
                            </Border>

                            <Button Name="ToolSelectionButton" Classes="tool-btn"
                                    ToolTip.Tip="Выделение (S / M)">
                                <PathIcon Data="{DynamicResource IconSelection}" Width="18" Height="18" />
                            </Button>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Brush Size Widget at Bottom -->
                    <Border Grid.Row="1"
                            Background="{DynamicResource SurfaceCardBrush}"
                            BorderBrush="{DynamicResource BorderSubtleBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="3,5"
                            Margin="0,6,0,0"
                            BoxShadow="0 2 6 0 #15000000">
                        <StackPanel Spacing="4" HorizontalAlignment="Center">
                            <TextBlock Text="КИСТЬ" FontSize="8" FontWeight="Bold"
                                       HorizontalAlignment="Center"
                                       Foreground="{DynamicResource TextMutedBrush}"
                                       LetterSpacing="0.8" />

                            <!-- Current Size Badge -->
                            <Border Background="{DynamicResource SurfacePanelBrush}"
                                    BorderBrush="{DynamicResource BorderSubtleBrush}"
                                    BorderThickness="1"
                                    CornerRadius="5"
                                    Padding="5,2"
                                    HorizontalAlignment="Center"
                                    ToolTip.Tip="Текущий размер кисти (1–32 px)">
                                <TextBlock Text="{Binding ToolViewModel.BrushSize, StringFormat='{}{0} px'}"
                                           FontSize="11" FontWeight="Bold"
                                           Foreground="{DynamicResource AccentPrimaryBrush}"
                                           HorizontalAlignment="Center" />
                            </Border>

                            <!-- Clean Stepper Grid: - / + -->
                            <Grid ColumnDefinitions="*,3,*" HorizontalAlignment="Center" Width="42">
                                <Button Grid.Column="0" Classes="size-btn"
                                        Command="{Binding ToolViewModel.DecreaseBrushSizeCommand}"
                                        ToolTip.Tip="Уменьшить кисть ([)">
                                    <TextBlock Text="−" FontSize="13" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Button>
                                <Button Grid.Column="2" Classes="size-btn"
                                        Command="{Binding ToolViewModel.IncreaseBrushSizeCommand}"
                                        ToolTip.Tip="Увеличить кисть (])">
                                    <TextBlock Text="+" FontSize="13" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Button>
                            </Grid>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- Center: Interactive SkiaSharp Canvas Control with Tool Context Bar & Floating HUD -->
            <Border Grid.Column="1" Background="{DynamicResource SurfaceBaseBrush}" ClipToBounds="True">
                <Grid RowDefinitions="Auto,*">
                    <!-- Tool Context Bar (Chip / Capsule UI) -->
                    <Border Grid.Row="0" Background="{DynamicResource SurfacePanelBrush}"
                            BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="0,0,0,1"
                            Padding="8,4" MinHeight="38">
                        <Grid ColumnDefinitions="*,Auto">
                            <!-- Tool Context Chips in Horizontal ScrollViewer -->
                            <ScrollViewer Grid.Column="0"
                                          HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled">
                                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                    <!-- 1. Tool Capsule: Icon + Tool Name -->
                                    <Border Classes="context-chip">
                                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                            <PathIcon x:Name="ActiveToolIcon"
                                                      Data="{Binding ToolViewModel.ActiveTool, Converter={StaticResource ToolToIconConverter}}"
                                                      Width="14" Height="14"
                                                      Foreground="{DynamicResource AccentPrimaryBrush}" />
                                            <TextBlock Text="{Binding ToolViewModel.ActiveToolDisplayName}"
                                                       FontSize="11" FontWeight="Bold"
                                                       Foreground="{DynamicResource AccentPrimaryBrush}"
                                                       VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Border>

                                    <!-- 2. Size Presets Capsule: 1, 2, 3, 4, 8 px -->
                                    <Border Classes="context-chip" IsVisible="{Binding ToolViewModel.SupportsBrushSize}">
                                        <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                            <TextBlock Text="Размер:" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"
                                                       VerticalAlignment="Center" Margin="0,0,3,0" />
                                            <Button Classes="size-preset-btn" Content="1" ToolTip.Tip="Кисть 1 px"
                                                    Command="{Binding ToolViewModel.SetBrushSizeCommand}">
                                                <Button.CommandParameter><x:Int32>1</x:Int32></Button.CommandParameter>
                                            </Button>
                                            <Button Classes="size-preset-btn" Content="2" ToolTip.Tip="Кисть 2 px"
                                                    Command="{Binding ToolViewModel.SetBrushSizeCommand}">
                                                <Button.CommandParameter><x:Int32>2</x:Int32></Button.CommandParameter>
                                            </Button>
                                            <Button Classes="size-preset-btn" Content="3" ToolTip.Tip="Кисть 3 px"
                                                    Command="{Binding ToolViewModel.SetBrushSizeCommand}">
                                                <Button.CommandParameter><x:Int32>3</x:Int32></Button.CommandParameter>
                                            </Button>
                                            <Button Classes="size-preset-btn" Content="4" ToolTip.Tip="Кисть 4 px"
                                                    Command="{Binding ToolViewModel.SetBrushSizeCommand}">
                                                <Button.CommandParameter><x:Int32>4</x:Int32></Button.CommandParameter>
                                            </Button>
                                            <Button Classes="size-preset-btn" Content="8" ToolTip.Tip="Кисть 8 px"
                                                    Command="{Binding ToolViewModel.SetBrushSizeCommand}">
                                                <Button.CommandParameter><x:Int32>8</x:Int32></Button.CommandParameter>
                                            </Button>
                                            <Border Background="{DynamicResource SurfacePanelBrush}"
                                                    BorderBrush="{DynamicResource BorderSubtleBrush}"
                                                    BorderThickness="1" CornerRadius="4" Padding="5,1" Margin="3,0,0,0">
                                                <TextBlock Text="{Binding ToolViewModel.BrushSize, StringFormat='{}{0}px'}"
                                                           FontSize="11" FontWeight="Bold"
                                                           Foreground="{DynamicResource AccentPrimaryBrush}" />
                                            </Border>
                                        </StackPanel>
                                    </Border>

                                    <!-- 3. Pixel-Perfect & Stabilizer Capsule -->
                                    <Border Classes="context-chip" IsVisible="{Binding ToolViewModel.SupportsPixelPerfect}">
                                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                            <!-- Pixel-Perfect Toggle -->
                                            <ToggleButton IsChecked="{Binding ToolViewModel.IsPixelPerfect, Mode=TwoWay}"
                                                          Classes="context-toggle-btn"
                                                          ToolTip.Tip="Pixel-Perfect: устранение изломов в 1px линиях (Shift+P)"
                                                          Height="26" Padding="6,2" CornerRadius="5">
                                                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                                    <Border Width="8" Height="8" CornerRadius="4"
                                                            Background="{DynamicResource AccentPrimaryBrush}"
                                                            BoxShadow="0 0 6 0 #00D2FF"
                                                            IsVisible="{Binding ToolViewModel.IsPixelPerfect}" />
                                                    <Border Width="8" Height="8" CornerRadius="4"
                                                            Background="{DynamicResource TextMutedBrush}"
                                                            Opacity="0.35"
                                                            IsVisible="{Binding !ToolViewModel.IsPixelPerfect}" />
                                                    <TextBlock Text="Pixel-Perfect" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" />
                                                </StackPanel>
                                            </ToggleButton>

                                            <Separator Width="1" Height="16" Background="{DynamicResource BorderSubtleBrush}" />

                                            <!-- Stabilizer -->
                                            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                                <TextBlock Text="Стабилизатор:" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" />
                                                <Slider Minimum="0" Maximum="10" Value="{Binding ToolViewModel.StabilizerStrength, Mode=TwoWay}"
                                                        Width="65" VerticalAlignment="Center" SmallChange="1" LargeChange="1" />
                                                <Border Background="{DynamicResource SurfacePanelBrush}"
                                                        BorderBrush="{DynamicResource BorderSubtleBrush}"
                                                        BorderThickness="1" CornerRadius="4" Padding="5,1">
                                                    <TextBlock Text="{Binding ToolViewModel.StabilizerStrength}" FontSize="11" FontWeight="Bold"
                                                               Foreground="{DynamicResource AccentPrimaryBrush}" VerticalAlignment="Center" Width="14" TextAlignment="Center" />
                                                </Border>
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>

                                    <!-- 4. Textures Capsule: 8x8 Pattern Preset (PatternBrush) -->
                                    <Border Classes="context-chip" IsVisible="{Binding ToolViewModel.Supports8x8Pattern}">
                                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                            <TextBlock Text="Текстура 8x8:" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" />
                                            <ComboBox ItemsSource="{Binding ToolViewModel.Available8x8Patterns}"
                                                      SelectedItem="{Binding ToolViewModel.SelectedPatternPreset, Mode=TwoWay}"
                                                      Height="26" FontSize="11" VerticalContentAlignment="Center" MinWidth="110" />
                                        </StackPanel>
                                    </Border>

                                    <!-- 5. Textures Capsule: Dither Pattern (Pencil, DitherBrush, Fill, Gradient, Shapes) -->
                                    <Border Classes="context-chip" IsVisible="{Binding ToolViewModel.SupportsDitherPattern}">
                                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                            <TextBlock Text="Дизеринг:" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" />
                                            <ComboBox ItemsSource="{Binding ToolViewModel.AvailablePatterns}"
                                                      SelectedItem="{Binding ToolViewModel.SelectedDitherPattern, Mode=TwoWay}"
                                                      Height="26" FontSize="11" VerticalContentAlignment="Center" MinWidth="100" />
                                        </StackPanel>
                                    </Border>

                                    <!-- 6. Flood Fill Settings Capsule: Tolerance & Contiguous (Fill, MagicWand) -->
                                    <Border Classes="context-chip" IsVisible="{Binding ToolViewModel.SupportsFillSettings}">
                                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                            <TextBlock Text="Порог:" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" />
                                            <NumericUpDown Value="{Binding ToolViewModel.FillTolerance, Mode=TwoWay}"
                                                           Minimum="0" Maximum="100" Increment="5" FormatString="{}{0}%"
                                                           Height="26" Width="76" FontSize="11" VerticalContentAlignment="Center" />
                                            <CheckBox IsChecked="{Binding ToolViewModel.FillContiguous, Mode=TwoWay}"
                                                      Content="Смежные" FontSize="11"
                                                      Foreground="{DynamicResource TextPrimaryBrush}"
                                                      ToolTip.Tip="Заливать только соединённую область или все схожие цвета на слое" />
                                        </StackPanel>
                                    </Border>

                                    <!-- 7. Gradient Settings Capsule: Linear / Radial & Multi-stop Presets -->
                                    <Border Classes="context-chip" IsVisible="{Binding ToolViewModel.SupportsGradientSettings}">
                                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                            <TextBlock Text="Градиент:" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" />
                                            <ComboBox ItemsSource="{Binding ToolViewModel.AvailableGradientTypes}"
                                                      SelectedItem="{Binding ToolViewModel.GradientType, Mode=TwoWay}"
                                                      Height="26" FontSize="11" VerticalContentAlignment="Center" MinWidth="85" />
                                            <TextBlock Text="Пресет:" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" />
                                            <ComboBox ItemsSource="{Binding ToolViewModel.AvailableGradientPresets}"
                                                      SelectedItem="{Binding ToolViewModel.SelectedGradientPreset, Mode=TwoWay}"
                                                      Height="26" FontSize="11" VerticalContentAlignment="Center" MinWidth="130"
                                                      ToolTip.Tip="Многоточечные градиентные пресеты и палитровые рампы">
                                                <ComboBox.ItemTemplate>
                                                    <DataTemplate>
                                                        <TextBlock Text="{Binding Name}" FontSize="11" />
                                                    </DataTemplate>
                                                </ComboBox.ItemTemplate>
                                            </ComboBox>
                                            <Button Content="Рампа..." Command="{Binding OpenColorRampDialogCommand}"
                                                    Height="26" Padding="8,2" FontSize="11"
                                                    Background="{DynamicResource SurfaceCardHoverBrush}"
                                                    BorderBrush="{DynamicResource BorderSubtleBrush}"
                                                    BorderThickness="1" CornerRadius="4"
                                                    ToolTip.Tip="Генератор палитровых рамп с Hue Shifting (от тени к свету)" />
                                        </StackPanel>
                                    </Border>

                                    <!-- 8. Shape Fill Capsule: Filled Shapes (Rectangle, Ellipse) -->
                                    <Border Classes="context-chip" IsVisible="{Binding ToolViewModel.SupportsShapeFill}">
                                        <CheckBox IsChecked="{Binding ToolViewModel.IsShapeFilled, Mode=TwoWay}"
                                                  Content="Заливка фигуры" FontSize="11"
                                                  Foreground="{DynamicResource TextPrimaryBrush}" />
                                    </Border>
                                </StackPanel>
                            </ScrollViewer>

                            <!-- Right: Zoom Capsule -->
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="6,0,0,0">
                                <Border Classes="context-chip">
                                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                        <PathIcon Data="{DynamicResource IconZoomIn}" Width="12" Height="12" Foreground="{DynamicResource TextMutedBrush}" />
                                        <TextBlock Text="Масштаб:" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding CanvasViewModel.ZoomText}" FontSize="11" FontWeight="Bold"
                                                   Foreground="{DynamicResource AccentPrimaryBrush}" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Canvas Area with Floating HUD Overlay -->
                    <Grid Grid.Row="1">
                        <!-- Interactive SkiaSharp Canvas Control -->
                        <controls:PixelCanvasControl Name="MainCanvasControl"
                                                    CanvasViewModel="{Binding CanvasViewModel}"
                                                    ToolViewModel="{Binding ToolViewModel}"
                                                    PaletteViewModel="{Binding PaletteViewModel}"
                                                    HistoryViewModel="{Binding HistoryViewModel}"
                                                    IsTiledMode="{Binding IsTiledMode, Mode=TwoWay}"
                                                    HorizontalAlignment="Stretch"
                                                    VerticalAlignment="Stretch" />

                        <!-- 3. Floating Canvas HUD (Controls Overlay Capsule) -->
                        <Border HorizontalAlignment="Center" VerticalAlignment="Bottom"
                                Margin="0,0,0,16"
                                Background="#D9141622"
                                CornerRadius="12"
                                Padding="12,5"
                                BorderBrush="{DynamicResource BorderSubtleBrush}"
                                BorderThickness="1"
                                Opacity="0.85"
                                IsHitTestVisible="False"
                                BoxShadow="0 4 16 0 #50000000">
                            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <!-- LMB -->
                                <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                    <Border Background="{DynamicResource SurfaceChipBrush}" CornerRadius="4" Padding="5,1">
                                        <TextBlock Text="ЛКМ" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource AccentPrimaryBrush}" />
                                    </Border>
                                    <TextBlock Text="Рисовать" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" />
                                </StackPanel>

                                <TextBlock Text="•" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" />

                                <!-- RMB -->
                                <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                    <Border Background="{DynamicResource SurfaceChipBrush}" CornerRadius="4" Padding="5,1">
                                        <TextBlock Text="ПКМ" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource AccentSecondaryBrush}" />
                                    </Border>
                                    <TextBlock Text="Стереть/Вторичный" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" />
                                </StackPanel>

                                <TextBlock Text="•" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" />

                                <!-- Space + Drag -->
                                <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                    <Border Background="{DynamicResource SurfaceChipBrush}" CornerRadius="4" Padding="5,1">
                                        <TextBlock Text="Пробел+Drag" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" />
                                    </Border>
                                    <TextBlock Text="Панорама" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" />
                                </StackPanel>

                                <TextBlock Text="•" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" />

                                <!-- Ctrl + Wheel -->
                                <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                    <Border Background="{DynamicResource SurfaceChipBrush}" CornerRadius="4" Padding="5,1">
                                        <TextBlock Text="Ctrl+Колесо" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" />
                                    </Border>
                                    <TextBlock Text="Зум" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Grid>
            </Border>

            <!-- Right: Inspector Column (Live Preview 1x, ColorPicker, Layer Manager) -->
            <Border Grid.Column="2" Background="{DynamicResource SurfacePanelBrush}"
                    BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1,0,0,0"
                    Padding="10">
                <Grid RowDefinitions="Auto,Auto,*">
                    <!-- Top: Live Preview 1x Control -->
                    <views:LivePreviewControl Grid.Row="0" Margin="0,0,0,10"
                                              CanvasSource="{Binding CanvasViewModel.Canvas}" />

                    <!-- Center: ColorPicker & Palette View -->
                    <views:ColorPickerView Grid.Row="1" Margin="0,0,0,10"
                                           DataContext="{Binding PaletteViewModel}" />

                    <!-- Bottom: Layers Manager Panel -->
                    <Border Grid.Row="2" Background="{DynamicResource SurfaceCardBrush}"
                            BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1"
                            CornerRadius="8" Padding="12">
                        <Grid RowDefinitions="Auto,Auto,*">
                            <!-- Layer Manager Header -->
                            <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,8">
                                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                    <PathIcon Data="{DynamicResource IconLayers}" Width="14" Height="14" Foreground="{DynamicResource AccentPrimaryBrush}" />
                                    <TextBlock Text="СЛОИ" FontSize="11" FontWeight="Bold"
                                               Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" />
                                </StackPanel>

                                <!-- Layer Actions -->
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4">
                                    <Button Classes="action-btn" Command="{Binding LayerViewModel.AddLayerCommand}" ToolTip.Tip="Добавить слой">
                                        <PathIcon Data="{DynamicResource IconAdd}" Width="13" Height="13" Foreground="{DynamicResource TextPrimaryBrush}" />
                                    </Button>
                                    <Button Classes="action-btn" Command="{Binding LayerViewModel.DuplicateLayerCommand}" ToolTip.Tip="Дублировать слой">
                                        <PathIcon Data="{DynamicResource IconNewFile}" Width="13" Height="13" Foreground="{DynamicResource TextPrimaryBrush}" />
                                    </Button>
                                    <Button Classes="action-btn" Command="{Binding LayerViewModel.MoveUpCommand}" ToolTip.Tip="Поднять слой выше">
                                        <PathIcon Data="{DynamicResource IconArrowUp}" Width="13" Height="13" Foreground="{DynamicResource TextPrimaryBrush}" />
                                    </Button>
                                    <Button Classes="action-btn" Command="{Binding LayerViewModel.MoveDownCommand}" ToolTip.Tip="Опустить слой ниже">
                                        <PathIcon Data="{DynamicResource IconArrowDown}" Width="13" Height="13" Foreground="{DynamicResource TextPrimaryBrush}" />
                                    </Button>
                                    <Button Classes="action-btn" Command="{Binding LayerViewModel.MergeDownCommand}" ToolTip.Tip="Объединить с нижним">
                                        <PathIcon Data="{DynamicResource IconMergeDown}" Width="13" Height="13" Foreground="{DynamicResource TextPrimaryBrush}" />
                                    </Button>
                                    <Button Classes="action-btn" Command="{Binding LayerViewModel.RemoveLayerCommand}" ToolTip.Tip="Удалить слой">
                                        <PathIcon Data="{DynamicResource IconDelete}" Width="13" Height="13" Foreground="{DynamicResource AccentDangerBrush}" />
                                    </Button>
                                </StackPanel>
                            </Grid>

                            <!-- Layer Opacity Slider -->
                            <Grid Grid.Row="1" ColumnDefinitions="Auto,*,36" Margin="0,0,0,8">
                                <TextBlock Grid.Column="0" Text="Непрозр." FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,8,0" />
                                <Slider Grid.Column="1" Minimum="0" Maximum="1" Value="{Binding LayerViewModel.ActiveLayer.Opacity, FallbackValue=1}"
                                        VerticalAlignment="Center" Margin="0,0,4,0" />
                                <TextBlock Grid.Column="2" Text="{Binding LayerViewModel.ActiveLayer.Opacity, StringFormat='{}{0:P0}', FallbackValue='100%'}"
                                           FontSize="10" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}" />
                            </Grid>

                            <!-- Layers ListBox -->
                            <ListBox Grid.Row="2" ItemsSource="{Binding LayerViewModel.Layers}"
                                     SelectedItem="{Binding LayerViewModel.ActiveLayer, Mode=TwoWay}"
                                     Background="Transparent" BorderThickness="0">
                                <ListBox.ItemTemplate>
                                    <DataTemplate x:DataType="models:Layer">
                                        <Grid ColumnDefinitions="Auto,Auto,*,Auto" Height="28">
                                            <!-- Visibility Toggle Button -->
                                            <Button Grid.Column="0" Classes="action-btn" Padding="4"
                                                    Command="{Binding #RootWindow.DataContext.LayerViewModel.ToggleVisibilityCommand}"
                                                    CommandParameter="{Binding}"
                                                    ToolTip.Tip="Видимость слоя">
                                                <Panel>
                                                    <PathIcon Data="{DynamicResource IconEye}" Width="13" Height="13"
                                                              IsVisible="{Binding IsVisible}"
                                                              Foreground="{DynamicResource AccentPrimaryBrush}" />
                                                    <PathIcon Data="{DynamicResource IconEyeOff}" Width="13" Height="13"
                                                              IsVisible="{Binding !IsVisible}"
                                                              Foreground="{DynamicResource TextMutedBrush}" />
                                                </Panel>
                                            </Button>

                                            <!-- Alpha Lock Toggle Button -->
                                            <Button Grid.Column="1" Classes="action-btn" Padding="4" Margin="2,0,0,0"
                                                    Command="{Binding #RootWindow.DataContext.LayerViewModel.ToggleAlphaLockCommand}"
                                                    CommandParameter="{Binding}"
                                                    ToolTip.Tip="Блокировка прозрачности (Alpha Lock)">
                                                <Panel>
                                                    <PathIcon Data="{DynamicResource IconLock}" Width="13" Height="13"
                                                              IsVisible="{Binding IsAlphaLocked}"
                                                              Foreground="{DynamicResource AccentPrimaryBrush}" />
                                                    <PathIcon Data="{DynamicResource IconLock}" Width="13" Height="13"
                                                              IsVisible="{Binding !IsAlphaLocked}"
                                                              Foreground="{DynamicResource TextMutedBrush}"
                                                              Opacity="0.4" />
                                                </Panel>
                                            </Button>

                                            <!-- Layer Name -->
                                            <TextBlock Grid.Column="2" Text="{Binding Name}" Margin="8,0"
                                                       VerticalAlignment="Center" FontSize="11"
                                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                                       TextTrimming="CharacterEllipsis" />

                                            <!-- Opacity text -->
                                            <TextBlock Grid.Column="3" Text="{Binding Opacity, StringFormat='{}{0:P0}'}"
                                                       VerticalAlignment="Center" FontSize="10"
                                                       Foreground="{DynamicResource TextMutedBrush}" />
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Grid>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <!-- 5. Bottom: StatusBar (Modern Capsule Design) -->
        <Border Grid.Row="4" Background="{DynamicResource SurfacePanelBrush}"
                BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="0,1,0,0"
                Height="30" Padding="10,0">
            <Grid ColumnDefinitions="*,Auto,Auto,Auto">
                <!-- Status Message with ready indicator -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                    <Border Width="6" Height="6" CornerRadius="3" Background="{DynamicResource AccentSuccessBrush}"
                            VerticalAlignment="Center" ToolTip.Tip="Готов к работе" />
                    <TextBlock Text="{Binding StatusMessage}"
                               VerticalAlignment="Center" FontSize="11"
                               Foreground="{DynamicResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                </StackPanel>

                <!-- Canvas Dimensions Capsule (Interactive Button -> opens ResizeCanvasDialog) -->
                <Button Name="StatusDimensionsButton" Grid.Column="1" Margin="4,0" Padding="8,2" VerticalAlignment="Center"
                        Height="22" Classes="status-capsule-btn"
                        ToolTip.Tip="Разрешение холста — нажмите для изменения размера (Ctrl+Alt+C)">
                    <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                        <PathIcon Data="{DynamicResource IconCrop}" Width="12" Height="12" Foreground="{DynamicResource AccentPrimaryBrush}" />
                        <TextBlock Text="{Binding CanvasViewModel.DimensionsText}" FontSize="11" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>

                <!-- Zoom Level Capsule Badge -->
                <Border Grid.Column="2" Margin="3,0" Padding="8,2" VerticalAlignment="Center" Height="22"
                        Classes="status-capsule-badge">
                    <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                        <TextBlock Text="Зум:" FontSize="10" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding CanvasViewModel.ZoomText}" FontSize="11" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" />
                    </StackPanel>
                </Border>

                <!-- Cursor Coordinates Capsule Badge -->
                <Border Grid.Column="3" Margin="3,0,0,0" Padding="8,2" VerticalAlignment="Center" Height="22"
                        Classes="status-capsule-badge">
                    <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                        <TextBlock Text="✛" FontSize="11" Foreground="{DynamicResource AccentPrimaryBrush}" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding CanvasViewModel.CursorCoordinatesText}" FontSize="11" FontWeight="SemiBold"
                                   Foreground="{DynamicResource AccentPrimaryBrush}" VerticalAlignment="Center" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>
