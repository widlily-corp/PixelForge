<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:PixelForge.App.ViewModels"
        xmlns:models="using:PixelForge.Core.Models"
        xmlns:controls="using:PixelForge.App.Controls"
        xmlns:views="using:PixelForge.App.Views"
        xmlns:converters="using:PixelForge.App.Converters"
        xmlns:loc="using:PixelForge.Core.Localization"
        mc:Ignorable="d" d:DesignWidth="1280" d:DesignHeight="800"
        x:Class="PixelForge.App.Views.MainWindow"
        x:Name="RootWindow"
        x:DataType="vm:MainViewModel"
        Title="{Binding Title, FallbackValue='PixelForge'}"
        Icon="/Assets/icon.ico"
        Width="1280" Height="800"
        MinWidth="1024" MinHeight="680"
        WindowStartupLocation="CenterScreen"
        Focusable="True"
        DragDrop.AllowDrop="True"
        Background="{DynamicResource SurfaceBaseBrush}">

    <Window.Resources>
        <views:ToolToIconGeometryConverter x:Key="ToolToIconConverter" />
        <converters:DitherPatternLocalizationConverter x:Key="DitherLocalizationConverter" />
        <converters:PixelColorToBrushConverter x:Key="PixelColorConverter" />
    </Window.Resources>

    <Window.Styles>
        <!-- Toolbar Tool Button Style -->
        <Style Selector="Button.tool-btn">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Width" Value="40" />
            <Setter Property="Height" Value="40" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="1.5" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="ToolTip.Placement" Value="Right" />
            <Setter Property="ToolTip.HorizontalOffset" Value="10" />
            <Setter Property="ToolTip.ShowDelay" Value="200" />
            <Setter Property="RenderTransform" Value="none" />
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.15" />
                    <BrushTransition Property="BorderBrush" Duration="0:0:0.15" />
                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.12" Easing="CubicEaseOut" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Button.tool-btn:pointerover">
            <Setter Property="Background" Value="{DynamicResource SurfaceCardHoverBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtleBrush}" />
            <Setter Property="RenderTransform" Value="scale(1.06)" />
        </Style>
        <Style Selector="Button.tool-btn:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource SurfaceCardHoverBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtleBrush}" />
        </Style>
        <Style Selector="Button.tool-btn:pressed">
            <Setter Property="RenderTransform" Value="scale(0.95)" />
        </Style>
        <Style Selector="Button.tool-btn.active">
            <Setter Property="Background" Value="{DynamicResource AccentGlowBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource AccentPrimaryBrush}" />
        </Style>
        <Style Selector="Button.tool-btn.active /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource AccentGlowBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource AccentPrimaryBrush}" />
        </Style>
        <Style Selector="Button.tool-btn.active PathIcon">
            <Setter Property="Foreground" Value="{DynamicResource AccentPrimaryBrush}" />
        </Style>
        <Style Selector="Button.tool-btn:not(.active) PathIcon">
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
        </Style>
        <Style Selector="Button.tool-btn:not(.active):pointerover PathIcon">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        </Style>

        <!-- Stepper Size Buttons -->
        <Style Selector="Button.size-btn">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Width" Value="19" />
            <Setter Property="Height" Value="20" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Background" Value="{DynamicResource SurfacePanelBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtleBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="RenderTransform" Value="none" />
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.1" />
                    <BrushTransition Property="BorderBrush" Duration="0:0:0.1" />
                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.1" Easing="CubicEaseOut" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Button.size-btn:pointerover">
            <Setter Property="Background" Value="{DynamicResource SurfaceCardHoverBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource AccentPrimaryBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource AccentPrimaryBrush}" />
            <Setter Property="RenderTransform" Value="scale(1.1)" />
        </Style>
        <Style Selector="Button.size-btn:pressed">
            <Setter Property="RenderTransform" Value="scale(0.92)" />
        </Style>

        <!-- Quick Size Preset Button Style -->
        <Style Selector="Button.size-preset-btn">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Width" Value="22" />
            <Setter Property="Height" Value="22" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="CornerRadius" Value="11" />
            <Setter Property="Background" Value="{DynamicResource SurfacePanelBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtleBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="FontSize" Value="10" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="RenderTransform" Value="none" />
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.1" />
                    <BrushTransition Property="BorderBrush" Duration="0:0:0.1" />
                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.1" Easing="CubicEaseOut" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Button.size-preset-btn:pointerover">
            <Setter Property="Background" Value="{DynamicResource SurfaceCardHoverBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource AccentPrimaryBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource AccentPrimaryBrush}" />
            <Setter Property="RenderTransform" Value="scale(1.12)" />
        </Style>
        <Style Selector="Button.size-preset-btn:pressed">
            <Setter Property="RenderTransform" Value="scale(0.92)" />
        </Style>

        <!-- Context Bar Chip / Capsule Border Style -->
        <Style Selector="Border.context-chip">
            <Setter Property="Background" Value="{DynamicResource SurfaceCardBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtleBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="8,3" />
            <Setter Property="Margin" Value="0,1,6,1" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <!-- Context Bar & Tool Option ToggleButton Style -->
        <Style Selector="ToggleButton.context-toggle-btn, ToggleButton.tool-opt-btn">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Height" Value="26" />
            <Setter Property="Padding" Value="6,2" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Background" Value="{DynamicResource SurfacePanelBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtleBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.1" />
                    <BrushTransition Property="BorderBrush" Duration="0:0:0.1" />
                    <BrushTransition Property="Foreground" Duration="0:0:0.1" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="ToggleButton.context-toggle-btn:pointerover, ToggleButton.tool-opt-btn:pointerover">
            <Setter Property="Background" Value="{DynamicResource SurfaceCardHoverBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource AccentPrimaryBrush}" />
        </Style>
        <Style Selector="ToggleButton.context-toggle-btn:pointerover /template/ ContentPresenter#PART_ContentPresenter, ToggleButton.tool-opt-btn:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource SurfaceCardHoverBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource AccentPrimaryBrush}" />
        </Style>
        <Style Selector="ToggleButton.context-toggle-btn:pressed, ToggleButton.tool-opt-btn:pressed">
            <Setter Property="Background" Value="{DynamicResource SurfaceCardSelectedBrush}" />
        </Style>
        <Style Selector="ToggleButton.context-toggle-btn:pressed /template/ ContentPresenter#PART_ContentPresenter, ToggleButton.tool-opt-btn:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource SurfaceCardSelectedBrush}" />
        </Style>
        <Style Selector="ToggleButton.context-toggle-btn:checked, ToggleButton.tool-opt-btn:checked">
            <Setter Property="Background" Value="{DynamicResource AccentGlowBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource AccentPrimaryBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        </Style>
        <Style Selector="ToggleButton.context-toggle-btn:checked /template/ ContentPresenter#PART_ContentPresenter, ToggleButton.tool-opt-btn:checked /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource AccentGlowBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource AccentPrimaryBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        </Style>
        <Style Selector="ToggleButton.context-toggle-btn:checked:pointerover, ToggleButton.tool-opt-btn:checked:pointerover">
            <Setter Property="Background" Value="{DynamicResource AccentGlowBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource AccentPrimaryHoverBrush}" />
        </Style>
        <Style Selector="ToggleButton.context-toggle-btn:checked:pointerover /template/ ContentPresenter#PART_ContentPresenter, ToggleButton.tool-opt-btn:checked:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource AccentGlowBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource AccentPrimaryHoverBrush}" />
        </Style>

        <!-- Status Bar Capsule Button Style -->
        <Style Selector="Button.status-capsule-btn">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="CornerRadius" Value="11" />
            <Setter Property="Background" Value="{DynamicResource SurfaceCardBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtleBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="RenderTransform" Value="none" />
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.12" />
                    <BrushTransition Property="BorderBrush" Duration="0:0:0.12" />
                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.12" Easing="CubicEaseOut" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Button.status-capsule-btn:pointerover">
            <Setter Property="Background" Value="{DynamicResource SurfaceCardHoverBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource AccentPrimaryBrush}" />
            <Setter Property="RenderTransform" Value="scale(1.03)" />
        </Style>
        <Style Selector="Button.status-capsule-btn:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource SurfaceCardHoverBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource AccentPrimaryBrush}" />
        </Style>
        <Style Selector="Button.status-capsule-btn:pressed">
            <Setter Property="RenderTransform" Value="scale(0.97)" />
        </Style>

        <!-- Status Bar Capsule Badge Style -->
        <Style Selector="Border.status-capsule-badge">
            <Setter Property="CornerRadius" Value="11" />
            <Setter Property="Background" Value="{DynamicResource SurfaceCardBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtleBrush}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>

        <!-- Status Bar Capsule Toggle Style -->
        <Style Selector="ToggleButton.status-capsule-toggle">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="4,1" />
            <Setter Property="Height" Value="20" />
            <Setter Property="CornerRadius" Value="3" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style Selector="ToggleButton.status-capsule-toggle:pointerover">
            <Setter Property="Background" Value="{DynamicResource SurfaceCardHoverBrush}" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>
        <Style Selector="ToggleButton.status-capsule-toggle:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource SurfaceCardHoverBrush}" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>
        <Style Selector="ToggleButton.status-capsule-toggle:checked">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="{DynamicResource AccentPrimaryBrush}" />
        </Style>
        <Style Selector="ToggleButton.status-capsule-toggle:checked /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="{DynamicResource AccentPrimaryBrush}" />
        </Style>
        <Style Selector="ToggleButton.status-capsule-toggle:checked:pointerover">
            <Setter Property="Background" Value="{DynamicResource SurfaceCardHoverBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="{DynamicResource AccentPrimaryBrush}" />
        </Style>
        <Style Selector="ToggleButton.status-capsule-toggle:checked:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource SurfaceCardHoverBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="{DynamicResource AccentPrimaryBrush}" />
        </Style>

        <!-- Quick Action Icon Button Style -->
        <Style Selector="Button.action-btn, ToggleButton.action-btn">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Height" Value="30" />
            <Setter Property="Padding" Value="8,4" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="RenderTransform" Value="none" />
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.12" />
                    <BrushTransition Property="BorderBrush" Duration="0:0:0.12" />
                    <BrushTransition Property="Foreground" Duration="0:0:0.12" />
                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.1" Easing="CubicEaseOut" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Button.action-btn:pointerover, ToggleButton.action-btn:pointerover">
            <Setter Property="Background" Value="{DynamicResource SurfaceCardHoverBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtleBrush}" />
            <Setter Property="RenderTransform" Value="scale(1.06)" />
        </Style>
        <Style Selector="Button.action-btn:pointerover /template/ ContentPresenter#PART_ContentPresenter, ToggleButton.action-btn:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource SurfaceCardHoverBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtleBrush}" />
        </Style>
        <Style Selector="Button.action-btn:pressed, ToggleButton.action-btn:pressed">
            <Setter Property="RenderTransform" Value="scale(0.94)" />
        </Style>
        <Style Selector="ToggleButton.action-btn:checked">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        </Style>
        <Style Selector="ToggleButton.action-btn:checked /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        </Style>
        <Style Selector="ToggleButton.action-btn:checked:pointerover">
            <Setter Property="Background" Value="{DynamicResource SurfaceCardHoverBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtleBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="RenderTransform" Value="scale(1.06)" />
        </Style>
        <Style Selector="ToggleButton.action-btn:checked:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource SurfaceCardHoverBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtleBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        </Style>

        <!-- Quick Action Icon Toggle Button Style -->
        <Style Selector="ToggleButton.action-toggle-btn">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Height" Value="30" />
            <Setter Property="Width" Value="32" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="RenderTransform" Value="none" />
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.12" />
                    <BrushTransition Property="BorderBrush" Duration="0:0:0.12" />
                    <BrushTransition Property="Foreground" Duration="0:0:0.12" />
                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.1" Easing="CubicEaseOut" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="ToggleButton.action-toggle-btn:pointerover">
            <Setter Property="Background" Value="{DynamicResource SurfaceCardHoverBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtleBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="RenderTransform" Value="scale(1.06)" />
        </Style>
        <Style Selector="ToggleButton.action-toggle-btn:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource SurfaceCardHoverBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtleBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        </Style>
        <Style Selector="ToggleButton.action-toggle-btn:pressed">
            <Setter Property="RenderTransform" Value="scale(0.94)" />
        </Style>
        <Style Selector="ToggleButton.action-toggle-btn:checked">
            <Setter Property="Background" Value="{DynamicResource AccentGlowBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource AccentPrimaryBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource AccentPrimaryBrush}" />
        </Style>
        <Style Selector="ToggleButton.action-toggle-btn:checked /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource AccentGlowBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource AccentPrimaryBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource AccentPrimaryBrush}" />
        </Style>
        <Style Selector="ToggleButton.action-toggle-btn:checked:pointerover">
            <Setter Property="Background" Value="{DynamicResource AccentGlowBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource AccentPrimaryHoverBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource AccentPrimaryHoverBrush}" />
            <Setter Property="RenderTransform" Value="scale(1.06)" />
        </Style>
        <Style Selector="ToggleButton.action-toggle-btn:checked:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource AccentGlowBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource AccentPrimaryHoverBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource AccentPrimaryHoverBrush}" />
        </Style>

        <!-- Layers ListBoxItem Style -->
        <Style Selector="ListBoxItem">
            <Setter Property="Padding" Value="4,2" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Margin" Value="0,1" />
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.12" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="ListBoxItem:pointerover">
            <Setter Property="Background" Value="{DynamicResource SurfaceCardHoverBrush}" />
        </Style>
        <Style Selector="ListBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource SurfaceCardHoverBrush}" />
        </Style>
        <Style Selector="ListBoxItem:selected">
            <Setter Property="Background" Value="{DynamicResource SurfaceCardSelectedBrush}" />
        </Style>
        <Style Selector="ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource SurfaceCardSelectedBrush}" />
        </Style>

        <!-- Inspector Card Header ToggleButton Style -->
        <Style Selector="ToggleButton.inspector-card-header">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Height" Value="26" />
            <Setter Property="Padding" Value="6,2" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.1" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="ToggleButton.inspector-card-header:pointerover">
            <Setter Property="Background" Value="{DynamicResource SurfaceCardHoverBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="BorderBrush" Value="Transparent" />
        </Style>
        <Style Selector="ToggleButton.inspector-card-header:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource SurfaceCardHoverBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="BorderBrush" Value="Transparent" />
        </Style>
        <Style Selector="ToggleButton.inspector-card-header:pressed">
            <Setter Property="Background" Value="{DynamicResource SurfaceCardSelectedBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="BorderBrush" Value="Transparent" />
        </Style>
        <Style Selector="ToggleButton.inspector-card-header:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource SurfaceCardSelectedBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="BorderBrush" Value="Transparent" />
        </Style>
        <Style Selector="ToggleButton.inspector-card-header:checked">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        </Style>
        <Style Selector="ToggleButton.inspector-card-header:checked /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        </Style>
        <Style Selector="ToggleButton.inspector-card-header:checked:pointerover">
            <Setter Property="Background" Value="{DynamicResource SurfaceCardHoverBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        </Style>
        <Style Selector="ToggleButton.inspector-card-header:checked:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource SurfaceCardHoverBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        </Style>
        <Style Selector="ToggleButton.inspector-card-header:checked:pressed">
            <Setter Property="Background" Value="{DynamicResource SurfaceCardSelectedBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        </Style>
        <Style Selector="ToggleButton.inspector-card-header:checked:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource SurfaceCardSelectedBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        </Style>
    </Window.Styles>

    <Grid RowDefinitions="Auto,Auto,Auto,*,Auto">
        <!-- 1. Top MenuBar -->
        <Border Grid.Row="0" Background="{DynamicResource SurfacePanelBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="0,0,0,1">
            <Menu Height="28">
                <!-- File Menu -->
                <MenuItem Header="{Binding Loc[Menu_File]}">
                    <MenuItem Name="MenuNew" Header="{Binding Loc[Menu_New]}" HotKey="Ctrl+N" />
                    <MenuItem Header="{Binding Loc[Menu_Open]}" HotKey="Ctrl+O" Command="{Binding OpenProjectCommand}" />
                    <MenuItem Name="MenuRecentFiles" Header="{Binding Loc[Menu_RecentFiles]}">
                        <MenuItem Header="{Binding Loc[Menu_NoRecentFiles]}" IsVisible="{Binding !HasRecentProjects}" IsEnabled="False" />
                        <MenuItem Name="MenuClearRecent" Header="{Binding Loc[Menu_ClearRecentFiles]}" Command="{Binding ClearRecentProjectsCommand}" IsVisible="{Binding HasRecentProjects}" />
                    </MenuItem>
                    <MenuItem Header="{Binding Loc[Menu_Save]}" HotKey="Ctrl+S" Command="{Binding SaveProjectCommand}" />
                    <MenuItem Header="{Binding Loc[Menu_SaveAs]}" HotKey="Ctrl+Shift+S" Command="{Binding SaveProjectAsCommand}" />
                    <Separator />
                    <MenuItem Header="{Binding Loc[Menu_ExportPng]}" Command="{Binding ExportPngCommand}" />
                    <MenuItem Header="{Binding Loc[Menu_ExportBmp]}" Command="{Binding ExportBmpCommand}" />
                    <Separator />
                    <MenuItem Header="{Binding Loc[Menu_AssociateFiles]}" Command="{Binding RegisterFileAssociationCommand}" />
                    <Separator />
                    <MenuItem Name="MenuExit" Header="{Binding Loc[Menu_Exit]}" HotKey="Alt+F4" />
                </MenuItem>

                <!-- Edit Menu -->
                <MenuItem Header="{Binding Loc[Menu_Edit]}">
                    <MenuItem Header="{Binding Loc[Menu_Undo]}" HotKey="Ctrl+Z" Command="{Binding HistoryViewModel.UndoCommand}" />
                    <MenuItem Header="{Binding Loc[Menu_Redo]}" HotKey="Ctrl+Y" Command="{Binding HistoryViewModel.RedoCommand}" />
                    <Separator />
                    <MenuItem Header="{Binding Loc[Menu_Cut]}" HotKey="Ctrl+X" Command="{Binding CutCommand}" />
                    <MenuItem Header="{Binding Loc[Menu_Copy]}" HotKey="Ctrl+C" Command="{Binding CopyCommand}" />
                    <MenuItem Header="{Binding Loc[Menu_Paste]}" HotKey="Ctrl+V" Command="{Binding PasteCommand}" />
                    <Separator />
                    <MenuItem Header="{Binding Loc[Menu_SelectAll]}" HotKey="Ctrl+A" Command="{Binding SelectAllCommand}" />
                    <MenuItem Header="{Binding Loc[Menu_Deselect]}" HotKey="Ctrl+D" Command="{Binding DeselectCommand}" />
                    <MenuItem Header="{Binding Loc[Menu_DeleteSelection]}" HotKey="Delete" Command="{Binding DeleteSelectionOrClearLayerCommand}" />
                </MenuItem>

                <!-- Canvas Menu -->
                <MenuItem Header="{Binding Loc[Menu_Canvas]}">
                    <MenuItem Name="MenuResizeCanvas" Header="{Binding Loc[Menu_ResizeCanvas]}" HotKey="Ctrl+Alt+C" />
                    <Separator />
                    <MenuItem Header="{Binding Loc[Menu_LayerTransform]}">
                        <MenuItem Header="{Binding Loc[Menu_FlipLayerH]}" Command="{Binding FlipActiveLayerHorizontalCommand}" />
                        <MenuItem Header="{Binding Loc[Menu_FlipLayerV]}" Command="{Binding FlipActiveLayerVerticalCommand}" />
                        <Separator />
                        <MenuItem Header="{Binding Loc[Menu_RotateLayerCW]}" Command="{Binding RotateActiveLayerCWCommand}" />
                        <MenuItem Header="{Binding Loc[Menu_RotateLayerCCW]}" Command="{Binding RotateActiveLayerCCWCommand}" />
                        <MenuItem Header="{Binding Loc[Menu_RotateLayer180]}" Command="{Binding RotateActiveLayer180Command}" />
                    </MenuItem>
                    <MenuItem Header="{Binding Loc[Menu_CanvasTransform]}">
                        <MenuItem Header="{Binding Loc[Menu_FlipCanvasH]}" Command="{Binding FlipCanvasHorizontalCommand}" />
                        <MenuItem Header="{Binding Loc[Menu_FlipCanvasV]}" Command="{Binding FlipCanvasVerticalCommand}" />
                        <Separator />
                        <MenuItem Header="{Binding Loc[Menu_RotateCanvasCW]}" Command="{Binding RotateCanvasCWCommand}" />
                        <MenuItem Header="{Binding Loc[Menu_RotateCanvasCCW]}" Command="{Binding RotateCanvasCCWCommand}" />
                        <MenuItem Header="{Binding Loc[Menu_RotateCanvas180]}" Command="{Binding RotateCanvas180Command}" />
                    </MenuItem>
                    <Separator />
                    <MenuItem Header="{Binding Loc[Menu_ReferenceImage]}">
                        <MenuItem Header="{Binding Loc[Menu_LoadReference]}" Command="{Binding LoadReferenceImageCommand}" />
                        <MenuItem Header="{Binding Loc[Menu_ToggleReference]}" Command="{Binding CanvasViewModel.ToggleReferenceVisibilityCommand}" />
                        <MenuItem Header="{Binding Loc[Menu_ClearReference]}" Command="{Binding ClearReferenceImageCommand}" />
                    </MenuItem>
                    <Separator />
                    <MenuItem Header="{Binding Loc[Menu_ClearActiveLayer]}" Command="{Binding ClearActiveLayerCommand}" />
                    <Separator />
                    <MenuItem Header="{Binding Loc[Menu_SmartTools]}">
                        <MenuItem Header="{Binding Loc[Menu_AddOutline]}" Command="{Binding AddOutlineCommand}" />
                        <MenuItem Header="{Binding Loc[Menu_AddShadow]}" Command="{Binding AddShadowCommand}" />
                        <MenuItem Header="{Binding Loc[Menu_ReplaceColor]}" Command="{Binding ReplaceColorCommand}" />
                        <Separator />
                        <MenuItem Header="{Binding Loc[Menu_ColorRamp]}" Command="{Binding OpenColorRampDialogCommand}" />
                        <Separator />
                        <MenuItem Header="{Binding Loc[Menu_TiledMode]}" HotKey="F10" Command="{Binding ToggleTiledModeCommand}" />
                    </MenuItem>
                </MenuItem>

                <!-- View Menu -->
                <MenuItem Header="{Binding Loc[Menu_View]}">
                    <MenuItem Header="{Binding Loc[Menu_Grid]}" HotKey="Ctrl+G" Command="{Binding CanvasViewModel.ToggleGridCommand}" />
                    <MenuItem Header="{Binding Loc[Menu_TileGrid]}" HotKey="Ctrl+Shift+G" Command="{Binding CanvasViewModel.ToggleTileGridCommand}">
                        <MenuItem.Icon>
                            <PathIcon Data="{DynamicResource IconTileGrid}" Width="14" Height="14" />
                        </MenuItem.Icon>
                    </MenuItem>
                    <MenuItem Header="{Binding Loc[Menu_SymmetryX]}" Command="{Binding CanvasViewModel.ToggleSymmetryXCommand}" />
                    <MenuItem Header="{Binding Loc[Menu_SymmetryY]}" Command="{Binding CanvasViewModel.ToggleSymmetryYCommand}" />
                    <MenuItem Header="{Binding Loc[Menu_TiledMode]}" HotKey="F10" Command="{Binding ToggleTiledModeCommand}" />
                    <Separator />
                    <MenuItem Header="{Binding Loc[Menu_ZoomIn]}" HotKey="Ctrl+Add" Command="{Binding CanvasViewModel.ZoomInCommand}" />
                    <MenuItem Header="{Binding Loc[Menu_ZoomOut]}" HotKey="Ctrl+Subtract" Command="{Binding CanvasViewModel.ZoomOutCommand}" />
                    <MenuItem Header="{Binding Loc[Menu_ResetZoom]}" HotKey="Ctrl+D0" Command="{Binding CanvasViewModel.ResetZoomCommand}" />
                    <Separator />
                    <MenuItem Name="MenuToggleTheme" Header="{Binding Loc[Menu_ToggleTheme]}" />
                    <Separator />
                    <MenuItem Header="{Binding Loc[Menu_Language]}">
                        <MenuItem Name="MenuLangRu" Header="{Binding Loc[Menu_LangRu]}" />
                        <MenuItem Name="MenuLangEn" Header="{Binding Loc[Menu_LangEn]}" />
                    </MenuItem>
                </MenuItem>

                <!-- Help Menu -->
                <MenuItem Header="{Binding Loc[Menu_Help]}">
                    <MenuItem Name="MenuHotkeys" Header="{Binding Loc[Menu_Hotkeys]}" HotKey="F1" Command="{Binding OpenHotkeysDialogCommand}" />
                    <MenuItem Header="{Binding Loc[Menu_CheckUpdates]}" Command="{Binding CheckForUpdatesCommand}" />
                    <Separator />
                    <MenuItem Name="MenuAbout" Header="{Binding Loc[Menu_About]}" />
                </MenuItem>
            </Menu>
        </Border>

        <!-- 2. Quick Action Toolbar -->
        <Border Grid.Row="1" Background="{DynamicResource SurfaceCardBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="0,0,0,1" Padding="8,4">
            <Grid ColumnDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,*,Auto">
                <!-- 1. File Shortcuts & Quick Export -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="4">
                    <Button Name="QuickNewButton" Classes="action-btn" ToolTip.Tip="{Binding Loc[Tip_NewCanvas]}">
                        <PathIcon Data="{DynamicResource IconNewFile}" Width="16" Height="16" Foreground="{DynamicResource TextPrimaryBrush}" />
                    </Button>
                    <Button Name="QuickResizeButton" Classes="action-btn" ToolTip.Tip="{Binding Loc[Tip_ResizeCanvas]}">
                        <PathIcon Data="{DynamicResource IconCrop}" Width="16" Height="16" Foreground="{DynamicResource TextPrimaryBrush}" />
                    </Button>
                    <Button Classes="action-btn" Command="{Binding OpenProjectCommand}" ToolTip.Tip="{Binding Loc[Tip_OpenProject]}">
                        <PathIcon Data="{DynamicResource IconFolderOpen}" Width="16" Height="16" Foreground="{DynamicResource TextPrimaryBrush}" />
                    </Button>
                    <Button Classes="action-btn" Command="{Binding SaveProjectCommand}" ToolTip.Tip="{Binding Loc[Tip_SaveProject]}">
                        <PathIcon Data="{DynamicResource IconSave}" Width="16" Height="16" Foreground="{DynamicResource TextPrimaryBrush}" />
                    </Button>
                </StackPanel>

                <Separator Grid.Column="1" Width="1" Height="20" Margin="6,0" Background="{DynamicResource BorderSubtleBrush}" />

                <!-- 2. Quick Export Dropdown -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4">
                    <Button Classes="action-btn" ToolTip.Tip="{Binding Loc[Tip_QuickExport]}">
                        <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                            <PathIcon Data="{DynamicResource IconExport}" Width="15" Height="15" Foreground="{DynamicResource TextPrimaryBrush}" />
                            <TextBlock Text="▾" FontSize="9" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" />
                        </StackPanel>
                        <Button.Flyout>
                            <MenuFlyout Placement="Bottom">
                                <MenuItem Header="{Binding Loc[Menu_ExportPng]}" Command="{Binding ExportPngCommand}" />
                                <MenuItem Header="{Binding Loc[Menu_ExportBmp]}" Command="{Binding ExportBmpCommand}" />
                            </MenuFlyout>
                        </Button.Flyout>
                    </Button>
                </StackPanel>

                <Separator Grid.Column="3" Width="1" Height="20" Margin="6,0" Background="{DynamicResource BorderSubtleBrush}" />

                <!-- 3. History (Undo/Redo) -->
                <StackPanel Grid.Column="4" Orientation="Horizontal" Spacing="4">
                    <Button Classes="action-btn" Command="{Binding HistoryViewModel.UndoCommand}" ToolTip.Tip="{Binding Loc[Tip_Undo]}">
                        <PathIcon Data="{DynamicResource IconUndo}" Width="16" Height="16" Foreground="{DynamicResource TextPrimaryBrush}" />
                    </Button>
                    <Button Classes="action-btn" Command="{Binding HistoryViewModel.RedoCommand}" ToolTip.Tip="{Binding Loc[Tip_Redo]}">
                        <PathIcon Data="{DynamicResource IconRedo}" Width="16" Height="16" Foreground="{DynamicResource TextPrimaryBrush}" />
                    </Button>
                </StackPanel>

                <Separator Grid.Column="5" Width="1" Height="20" Margin="6,0" Background="{DynamicResource BorderSubtleBrush}" />

                <!-- 4. Quick Layer Transforms (Flip H, Flip V, Rotate CW) -->
                <StackPanel Grid.Column="6" Orientation="Horizontal" Spacing="3">
                    <Button Classes="action-btn" Command="{Binding FlipActiveLayerHorizontalCommand}" ToolTip.Tip="{Binding Loc[Tip_FlipH]}">
                        <PathIcon Data="{DynamicResource IconFlipH}" Width="15" Height="15" Foreground="{DynamicResource TextPrimaryBrush}" />
                    </Button>
                    <Button Classes="action-btn" Command="{Binding FlipActiveLayerVerticalCommand}" ToolTip.Tip="{Binding Loc[Tip_FlipV]}">
                        <PathIcon Data="{DynamicResource IconFlipV}" Width="15" Height="15" Foreground="{DynamicResource TextPrimaryBrush}" />
                    </Button>
                    <Button Classes="action-btn" Command="{Binding RotateActiveLayerCWCommand}" ToolTip.Tip="{Binding Loc[Tip_RotateCW]}">
                        <PathIcon Data="{DynamicResource IconRotateCW}" Width="14" Height="14" Foreground="{DynamicResource TextPrimaryBrush}" />
                    </Button>
                </StackPanel>

                <Separator Grid.Column="7" Width="1" Height="20" Margin="6,0" Background="{DynamicResource BorderSubtleBrush}" />

                <!-- 5. Overlays: Grid, Symmetry, Tiled & Smart Tools Dropdown -->
                <StackPanel Grid.Column="8" Orientation="Horizontal" Spacing="4">
                    <ToggleButton Name="GridToggle" IsChecked="{Binding CanvasViewModel.ShowGrid, Mode=TwoWay}"
                                  Classes="action-toggle-btn"
                                  ToolTip.Tip="{Binding Loc[Tip_Grid]}">
                        <PathIcon Data="{DynamicResource IconGrid}" Width="15" Height="15" />
                    </ToggleButton>

                    <ToggleButton Name="SymXToggle" IsChecked="{Binding CanvasViewModel.ShowSymmetryX, Mode=TwoWay}"
                                  Classes="action-toggle-btn"
                                  ToolTip.Tip="{Binding Loc[Tip_SymX]}">
                        <PathIcon Data="{DynamicResource IconSymmetryX}" Width="15" Height="15" />
                    </ToggleButton>

                    <ToggleButton Name="SymYToggle" IsChecked="{Binding CanvasViewModel.ShowSymmetryY, Mode=TwoWay}"
                                  Classes="action-toggle-btn"
                                  ToolTip.Tip="{Binding Loc[Tip_SymY]}">
                        <PathIcon Data="{DynamicResource IconSymmetryY}" Width="15" Height="15" />
                    </ToggleButton>

                    <ToggleButton Name="TiledToggle" IsChecked="{Binding IsTiledMode, Mode=TwoWay}"
                                  Classes="action-toggle-btn"
                                  ToolTip.Tip="{Binding Loc[Tip_Tiled]}">
                        <PathIcon Data="{DynamicResource IconTiled}" Width="15" Height="15" />
                    </ToggleButton>

                    <ToggleButton Name="TileGridToggle" IsChecked="{Binding CanvasViewModel.ShowTileGrid, Mode=TwoWay}"
                                  Classes="action-toggle-btn"
                                  ToolTip.Tip="{Binding Loc[Tip_TileGrid]}">
                        <PathIcon Data="{DynamicResource IconTileGrid}" Width="15" Height="15" />
                    </ToggleButton>

                    <Separator Width="1" Height="18" Margin="3,0" Background="{DynamicResource BorderSubtleBrush}" />

                    <!-- Smart Tools FX Button -->
                    <Button Classes="action-btn" ToolTip.Tip="{Binding Loc[Tip_SmartTools]}">
                        <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                            <PathIcon Data="{DynamicResource IconMagicWand}" Width="14" Height="14" Foreground="{DynamicResource AccentPrimaryBrush}" />
                            <TextBlock Text="FX" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource AccentPrimaryBrush}" VerticalAlignment="Center" />
                            <TextBlock Text="▾" FontSize="9" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" />
                        </StackPanel>
                        <Button.Flyout>
                            <MenuFlyout Placement="Bottom">
                                <MenuItem Header="{Binding Loc[Menu_AddOutline]}" Command="{Binding AddOutlineCommand}" />
                                <MenuItem Header="{Binding Loc[Menu_AddShadow]}" Command="{Binding AddShadowCommand}" />
                                <MenuItem Header="{Binding Loc[Menu_ReplaceColor]}" Command="{Binding ReplaceColorCommand}" />
                                <Separator />
                                <MenuItem Header="{Binding Loc[Menu_ColorRamp]}" Command="{Binding OpenColorRampDialogCommand}" />
                            </MenuFlyout>
                        </Button.Flyout>
                    </Button>
                </StackPanel>

                <!-- 6. Zoom Controls & Theme Toggle -->
                <StackPanel Grid.Column="10" Orientation="Horizontal" Spacing="4">
                    <Button Classes="action-btn" Command="{Binding CanvasViewModel.ZoomOutCommand}" ToolTip.Tip="{Binding Loc[Tip_ZoomOut]}">
                        <PathIcon Data="{DynamicResource IconZoomOut}" Width="14" Height="14" Foreground="{DynamicResource TextPrimaryBrush}" />
                    </Button>
                    <TextBlock Text="{Binding CanvasViewModel.ZoomText}" Width="48" TextAlignment="Center"
                               VerticalAlignment="Center" FontSize="11" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextSecondaryBrush}" />
                    <Button Classes="action-btn" Command="{Binding CanvasViewModel.ZoomInCommand}" ToolTip.Tip="{Binding Loc[Tip_ZoomIn]}">
                        <PathIcon Data="{DynamicResource IconZoomIn}" Width="14" Height="14" Foreground="{DynamicResource TextPrimaryBrush}" />
                    </Button>
                    <Button Classes="action-btn" Command="{Binding CanvasViewModel.ResetZoomCommand}" ToolTip.Tip="{Binding Loc[Tip_ZoomFit]}">
                        <PathIcon Data="{DynamicResource IconZoomFit}" Width="14" Height="14" Foreground="{DynamicResource TextPrimaryBrush}" />
                    </Button>

                    <Separator Width="1" Height="20" Margin="4,0" Background="{DynamicResource BorderSubtleBrush}" />

                    <Button Name="QuickThemeButton" Classes="action-btn" ToolTip.Tip="{Binding Loc[Tip_ToggleTheme]}">
                        <PathIcon Data="{DynamicResource IconTheme}" Width="14" Height="14" Foreground="{DynamicResource AccentPrimaryBrush}" />
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 3. Update Banner Notification (if update is available) -->
        <Border Grid.Row="2" Background="{DynamicResource AccentPrimaryBrush}" Padding="12,6"
                IsVisible="{Binding IsUpdateBannerVisible}">
            <Grid ColumnDefinitions="*,Auto,Auto,Auto">
                <StackPanel Grid.Column="0" Orientation="Vertical" VerticalAlignment="Center" Spacing="2">
                    <TextBlock Text="{Binding UpdateBannerMessage}"
                               VerticalAlignment="Center" FontSize="12" FontWeight="SemiBold" Foreground="#0A0E17" />
                    <ProgressBar Minimum="0" Maximum="100" Value="{Binding UpdateProgress}"
                                 Height="4" Foreground="#0A0E17" Background="#400A0E17"
                                 IsVisible="{Binding IsUpdating}" />
                    <TextBlock Text="{Binding UpdateStatusText}" FontSize="10" Foreground="#0A0E17"
                               IsVisible="{Binding IsUpdating}" />
                </StackPanel>
                <Button Grid.Column="1" Content="{Binding Loc[Banner_UpdateNow]}" Margin="8,0" Padding="12,4" CornerRadius="4"
                        Background="#0A0E17" Foreground="#FFFFFF" FontSize="11" FontWeight="Bold"
                        Command="{Binding ApplyUpdateCommand}" IsEnabled="{Binding !IsUpdating}"
                        ToolTip.Tip="{Binding Loc[Banner_UpdateTooltip]}" />
                <Button Grid.Column="2" Content="{Binding Loc[Banner_Website]}" Margin="0,0,8,0" Padding="8,4" CornerRadius="4"
                        Background="Transparent" BorderBrush="#0A0E17" BorderThickness="1" Foreground="#0A0E17" FontSize="11"
                        Command="{Binding OpenUpdateDownloadPageCommand}" IsEnabled="{Binding !IsUpdating}" />
                <Button Grid.Column="3" Content="✕" Padding="6,4" CornerRadius="4"
                        Background="Transparent" Foreground="#0A0E17" FontSize="12" FontWeight="Bold"
                        Command="{Binding DismissUpdateBannerCommand}" IsEnabled="{Binding !IsUpdating}" />
            </Grid>
        </Border>

        <!-- 4. Workspace Area with Splitter -->
        <Grid Grid.Row="3" ColumnDefinitions="58,*,4,320">
            <!-- Left: Tools Palette Column -->
            <Border Grid.Column="0" Background="{DynamicResource SurfacePanelBrush}"
                    BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="0,0,1,0"
                    Padding="5,8"
                    BoxShadow="1 0 6 0 #10000000">
                <Grid RowDefinitions="*,Auto">
                    <!-- Tools List grouped into 4 logical sections with ScrollViewer for all resolutions -->
                    <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Spacing="3" HorizontalAlignment="Center">
                            <!-- 1. РИСОВАНИЕ -->
                            <Border Background="{DynamicResource SurfaceChipBrush}" CornerRadius="3"
                                    Padding="4,1" Margin="0,2,0,2" HorizontalAlignment="Center"
                                    ToolTip.Tip="{Binding Loc[ToolSection_DrawingTip]}">
                                <TextBlock Text="{Binding Loc[ToolSection_Drawing]}" FontSize="7" FontWeight="Bold"
                                           Foreground="{DynamicResource TextMutedBrush}" LetterSpacing="0.5" />
                            </Border>

                            <Button Name="ToolPencilButton" Classes="tool-btn"
                                    ToolTip.Tip="{Binding Loc[Tool_PencilTip]}">
                                <PathIcon Data="{DynamicResource IconPencil}" Width="18" Height="18" />
                            </Button>

                            <Button Name="ToolEraserButton" Classes="tool-btn"
                                    ToolTip.Tip="{Binding Loc[Tool_EraserTip]}">
                                <PathIcon Data="{DynamicResource IconEraser}" Width="18" Height="18" />
                            </Button>

                            <Button Name="ToolDitherButton" Classes="tool-btn"
                                    ToolTip.Tip="{Binding Loc[Tool_DitherBrushTip]}">
                                <PathIcon Data="{DynamicResource IconDither}" Width="18" Height="18" />
                            </Button>

                            <Button Name="ToolPatternBrushButton" Classes="tool-btn"
                                    ToolTip.Tip="{Binding Loc[Tool_PatternBrushTip]}">
                                <PathIcon Data="{DynamicResource IconPatternBrush}" Width="18" Height="18" />
                            </Button>

                            <Button Name="ToolShadeBrushButton" Classes="tool-btn"
                                    ToolTip.Tip="{Binding Loc[Tool_ShadeBrushTip]}">
                                <PathIcon Data="{DynamicResource IconShadeBrush}" Width="18" Height="18" />
                            </Button>

                            <Button Name="ToolSprayBrushButton" Classes="tool-btn"
                                    ToolTip.Tip="{Binding Loc[Tool_SprayBrushTip]}">
                                <PathIcon Data="{DynamicResource IconSprayBrush}" Width="18" Height="18" />
                            </Button>

                            <Separator Height="1" Margin="4,4" Background="{DynamicResource BorderSubtleBrush}" />

                            <!-- 2. ЗАЛИВКА И ЦВЕТ -->
                            <Border Background="{DynamicResource SurfaceChipBrush}" CornerRadius="3"
                                    Padding="4,1" Margin="0,1,0,2" HorizontalAlignment="Center"
                                    ToolTip.Tip="{Binding Loc[ToolSection_FillTip]}">
                                <TextBlock Text="{Binding Loc[ToolSection_Fill]}" FontSize="7" FontWeight="Bold"
                                           Foreground="{DynamicResource TextMutedBrush}" LetterSpacing="0.5" />
                            </Border>

                            <Button Name="ToolFillButton" Classes="tool-btn"
                                    ToolTip.Tip="{Binding Loc[Tool_FillTip]}">
                                <PathIcon Data="{DynamicResource IconFill}" Width="18" Height="18" />
                            </Button>

                            <Button Name="ToolMagicWandButton" Classes="tool-btn"
                                    ToolTip.Tip="{Binding Loc[Tool_MagicWandTip]}">
                                <PathIcon Data="{DynamicResource IconMagicWand}" Width="18" Height="18" />
                            </Button>

                            <Button Name="ToolGradientButton" Classes="tool-btn"
                                    ToolTip.Tip="{Binding Loc[Tool_GradientTip]}">
                                <PathIcon Data="{DynamicResource IconGradient}" Width="18" Height="18" />
                            </Button>

                            <Button Name="ToolEyedropperButton" Classes="tool-btn"
                                    ToolTip.Tip="{Binding Loc[Tool_EyedropperTip]}">
                                <PathIcon Data="{DynamicResource IconEyedropper}" Width="18" Height="18" />
                            </Button>

                            <Separator Height="1" Margin="4,4" Background="{DynamicResource BorderSubtleBrush}" />

                            <!-- 3. ФИГУРЫ -->
                            <Border Background="{DynamicResource SurfaceChipBrush}" CornerRadius="3"
                                    Padding="4,1" Margin="0,1,0,2" HorizontalAlignment="Center"
                                    ToolTip.Tip="{Binding Loc[ToolSection_ShapesTip]}">
                                <TextBlock Text="{Binding Loc[ToolSection_Shapes]}" FontSize="7" FontWeight="Bold"
                                           Foreground="{DynamicResource TextMutedBrush}" LetterSpacing="0.5" />
                            </Border>

                            <Button Name="ToolLineButton" Classes="tool-btn"
                                    ToolTip.Tip="{Binding Loc[Tool_LineTip]}">
                                <PathIcon Data="{DynamicResource IconLine}" Width="18" Height="18" />
                            </Button>

                            <Button Name="ToolRectangleButton" Classes="tool-btn"
                                    ToolTip.Tip="{Binding Loc[Tool_RectangleTip]}">
                                <PathIcon Data="{DynamicResource IconRectangle}" Width="18" Height="18" />
                            </Button>

                            <Button Name="ToolEllipseButton" Classes="tool-btn"
                                    ToolTip.Tip="{Binding Loc[Tool_EllipseTip]}">
                                <PathIcon Data="{DynamicResource IconEllipse}" Width="18" Height="18" />
                            </Button>

                            <Separator Height="1" Margin="4,4" Background="{DynamicResource BorderSubtleBrush}" />

                            <!-- 4. ВЫДЕЛЕНИЕ -->
                            <Border Background="{DynamicResource SurfaceChipBrush}" CornerRadius="3"
                                    Padding="4,1" Margin="0,1,0,2" HorizontalAlignment="Center"
                                    ToolTip.Tip="{Binding Loc[ToolSection_SelectTip]}">
                                <TextBlock Text="{Binding Loc[ToolSection_Select]}" FontSize="7" FontWeight="Bold"
                                           Foreground="{DynamicResource TextMutedBrush}" LetterSpacing="0.5" />
                            </Border>

                            <Button Name="ToolSelectionButton" Classes="tool-btn"
                                    ToolTip.Tip="{Binding Loc[Tool_SelectionTip]}">
                                <PathIcon Data="{DynamicResource IconSelection}" Width="18" Height="18" />
                            </Button>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Brush Size Widget at Bottom -->
                    <Border Grid.Row="1"
                            Background="{DynamicResource SurfaceCardBrush}"
                            BorderBrush="{DynamicResource BorderSubtleBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="3,5"
                            Margin="0,6,0,0"
                            BoxShadow="0 2 6 0 #15000000">
                        <StackPanel Spacing="4" HorizontalAlignment="Center">
                            <TextBlock Text="{Binding Loc[Brush_Header]}" FontSize="8" FontWeight="Bold"
                                       HorizontalAlignment="Center"
                                       Foreground="{DynamicResource TextMutedBrush}"
                                       LetterSpacing="0.8" />

                            <!-- Current Size Badge -->
                            <Border Background="{DynamicResource SurfacePanelBrush}"
                                    BorderBrush="{DynamicResource BorderSubtleBrush}"
                                    BorderThickness="1"
                                    CornerRadius="5"
                                    Padding="5,2"
                                    HorizontalAlignment="Center"
                                    ToolTip.Tip="{Binding Loc[Brush_SizeCurrentTip]}">
                                <TextBlock Text="{Binding ToolViewModel.BrushSize, StringFormat='{}{0} px'}"
                                           FontSize="11" FontWeight="Bold"
                                           Foreground="{DynamicResource AccentPrimaryBrush}"
                                           HorizontalAlignment="Center" />
                            </Border>

                            <!-- Clean Stepper Grid: - / + -->
                            <Grid ColumnDefinitions="*,3,*" HorizontalAlignment="Center" Width="42">
                                <Button Grid.Column="0" Classes="size-btn"
                                        Command="{Binding ToolViewModel.DecreaseBrushSizeCommand}"
                                        ToolTip.Tip="{Binding Loc[Brush_DecreaseTip]}">
                                    <TextBlock Text="−" FontSize="13" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Button>
                                <Button Grid.Column="2" Classes="size-btn"
                                        Command="{Binding ToolViewModel.IncreaseBrushSizeCommand}"
                                        ToolTip.Tip="{Binding Loc[Brush_IncreaseTip]}">
                                    <TextBlock Text="+" FontSize="13" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Button>
                            </Grid>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- Center: Interactive SkiaSharp Canvas Control with Tool Context Bar & Floating HUD -->
            <Border Grid.Column="1" Background="{DynamicResource SurfaceBaseBrush}" ClipToBounds="True">
                <Grid RowDefinitions="Auto,*">
                    <!-- Tool Context Bar (Chip / Capsule UI) -->
                    <Border Grid.Row="0" Background="{DynamicResource SurfacePanelBrush}"
                            BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="0,0,0,1"
                            Padding="8,4" MinHeight="38">
                        <Grid ColumnDefinitions="*">
                            <!-- Tool Context Chips in Adaptive WrapPanel with ScrollViewer Fallback -->
                            <ScrollViewer Grid.Column="0"
                                          HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" MaxHeight="78">
                                <WrapPanel Orientation="Horizontal" Margin="0,2">
                                    <!-- 1. Tool Capsule: Icon + Tool Name -->
                                    <Border Classes="context-chip">
                                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                            <PathIcon x:Name="ActiveToolIcon"
                                                      Data="{Binding ToolViewModel.ActiveTool, Converter={StaticResource ToolToIconConverter}}"
                                                      Width="14" Height="14"
                                                      Foreground="{DynamicResource AccentPrimaryBrush}" />
                                            <TextBlock Text="{Binding ToolViewModel.ActiveToolDisplayName}"
                                                       FontSize="11" FontWeight="Bold"
                                                       Foreground="{DynamicResource AccentPrimaryBrush}"
                                                       VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Border>

                                    <!-- 2. Size Presets Capsule: 1, 2, 3, 4, 8 px -->
                                    <Border Classes="context-chip" IsVisible="{Binding ToolViewModel.SupportsBrushSize}">
                                        <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Loc[Context_Size]}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"
                                                       VerticalAlignment="Center" Margin="0,0,3,0" />
                                            <Button Classes="size-preset-btn" Content="1" ToolTip.Tip="{Binding Loc[Context_BrushTip1]}"
                                                    Command="{Binding ToolViewModel.SetBrushSizeCommand}">
                                                <Button.CommandParameter><x:Int32>1</x:Int32></Button.CommandParameter>
                                            </Button>
                                            <Button Classes="size-preset-btn" Content="2" ToolTip.Tip="{Binding Loc[Context_BrushTip2]}"
                                                    Command="{Binding ToolViewModel.SetBrushSizeCommand}">
                                                <Button.CommandParameter><x:Int32>2</x:Int32></Button.CommandParameter>
                                            </Button>
                                            <Button Classes="size-preset-btn" Content="3" ToolTip.Tip="{Binding Loc[Context_BrushTip3]}"
                                                    Command="{Binding ToolViewModel.SetBrushSizeCommand}">
                                                <Button.CommandParameter><x:Int32>3</x:Int32></Button.CommandParameter>
                                            </Button>
                                            <Button Classes="size-preset-btn" Content="4" ToolTip.Tip="{Binding Loc[Context_BrushTip4]}"
                                                    Command="{Binding ToolViewModel.SetBrushSizeCommand}">
                                                <Button.CommandParameter><x:Int32>4</x:Int32></Button.CommandParameter>
                                            </Button>
                                            <Button Classes="size-preset-btn" Content="8" ToolTip.Tip="{Binding Loc[Context_BrushTip8]}"
                                                    Command="{Binding ToolViewModel.SetBrushSizeCommand}">
                                                <Button.CommandParameter><x:Int32>8</x:Int32></Button.CommandParameter>
                                            </Button>
                                            <Border Background="{DynamicResource SurfacePanelBrush}"
                                                    BorderBrush="{DynamicResource BorderSubtleBrush}"
                                                    BorderThickness="1" CornerRadius="4" Padding="5,1" Margin="3,0,0,0">
                                                <TextBlock Text="{Binding ToolViewModel.BrushSize, StringFormat='{}{0}px'}"
                                                           FontSize="11" FontWeight="Bold"
                                                           Foreground="{DynamicResource AccentPrimaryBrush}" />
                                            </Border>
                                        </StackPanel>
                                    </Border>

                                    <!-- 3. Pixel-Perfect & Stabilizer Capsule -->
                                    <Border Classes="context-chip" IsVisible="{Binding ToolViewModel.SupportsPixelPerfect}">
                                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                            <!-- Pixel-Perfect Toggle -->
                                            <ToggleButton IsChecked="{Binding ToolViewModel.IsPixelPerfect, Mode=TwoWay}"
                                                          Classes="context-toggle-btn tool-opt-btn"
                                                          ToolTip.Tip="{Binding Loc[Context_PixelPerfectTip]}"
                                                          Height="26" Padding="6,2" CornerRadius="6">
                                                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                                    <PathIcon Data="{DynamicResource IconPixelPerfect}" Width="12" Height="12" Foreground="{DynamicResource AccentPrimaryBrush}" />
                                                    <Border Width="8" Height="8" CornerRadius="4"
                                                            Background="{DynamicResource AccentPrimaryBrush}"
                                                            BoxShadow="0 0 6 0 #00D2FF"
                                                            IsVisible="{Binding ToolViewModel.IsPixelPerfect}" />
                                                    <Border Width="8" Height="8" CornerRadius="4"
                                                            Background="{DynamicResource TextMutedBrush}"
                                                            Opacity="0.35"
                                                            IsVisible="{Binding !ToolViewModel.IsPixelPerfect}" />
                                                    <TextBlock Text="{Binding Loc[Context_PixelPerfect]}" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" />
                                                </StackPanel>
                                            </ToggleButton>

                                            <Separator Width="1" Height="16" Background="{DynamicResource BorderSubtleBrush}" />

                                            <!-- Stabilizer -->
                                            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Loc[Context_Stabilizer]}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" />
                                                <Slider Minimum="0" Maximum="10" Value="{Binding ToolViewModel.StabilizerStrength, Mode=TwoWay}"
                                                        Width="65" VerticalAlignment="Center" SmallChange="1" LargeChange="1" />
                                                <Border Background="{DynamicResource SurfacePanelBrush}"
                                                        BorderBrush="{DynamicResource BorderSubtleBrush}"
                                                        BorderThickness="1" CornerRadius="4" Padding="5,1">
                                                    <TextBlock Text="{Binding ToolViewModel.StabilizerStrength}" FontSize="11" FontWeight="Bold"
                                                               Foreground="{DynamicResource AccentPrimaryBrush}" VerticalAlignment="Center" Width="14" TextAlignment="Center" />
                                                </Border>
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>

                                    <!-- Spray Brush Settings Capsule: Radius & Density -->
                                    <Border Classes="context-chip" IsVisible="{Binding ToolViewModel.SupportsSpraySettings}">
                                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                            <PathIcon Data="{DynamicResource IconSprayBrush}" Width="13" Height="13" Foreground="{DynamicResource AccentPrimaryBrush}" />
                                            <!-- Radius -->
                                            <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Loc[Context_SprayRadius]}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" />
                                                <NumericUpDown Value="{Binding ToolViewModel.SprayRadius, Mode=TwoWay}"
                                                               Minimum="1" Maximum="16" Increment="1"
                                                               Height="26" Width="68" FontSize="11" VerticalContentAlignment="Center" />
                                            </StackPanel>
                                            <Separator Width="1" Height="16" Background="{DynamicResource BorderSubtleBrush}" />
                                            <!-- Density -->
                                            <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Loc[Context_SprayDensity]}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" />
                                                <Slider Minimum="0.05" Maximum="1.0" Value="{Binding ToolViewModel.SprayDensity, Mode=TwoWay}"
                                                        Width="65" VerticalAlignment="Center" SmallChange="0.05" LargeChange="0.1" />
                                                <Border Background="{DynamicResource SurfacePanelBrush}"
                                                        BorderBrush="{DynamicResource BorderSubtleBrush}"
                                                        BorderThickness="1" CornerRadius="4" Padding="5,1">
                                                    <TextBlock Text="{Binding ToolViewModel.SprayDensity, StringFormat='{}{0:P0}'}" FontSize="10" FontWeight="Bold"
                                                               Foreground="{DynamicResource AccentPrimaryBrush}" VerticalAlignment="Center" Width="32" TextAlignment="Center" />
                                                </Border>
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>

                                    <!-- 4. Textures Capsule: 8x8 Pattern Preset (PatternBrush) -->
                                    <Border Classes="context-chip" IsVisible="{Binding ToolViewModel.Supports8x8Pattern}">
                                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Loc[Context_Texture8x8]}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" />
                                            <ComboBox ItemsSource="{Binding ToolViewModel.Available8x8Patterns}"
                                                      SelectedItem="{Binding ToolViewModel.SelectedPatternPreset, Mode=TwoWay}"
                                                      Height="26" FontSize="11" VerticalContentAlignment="Center" MinWidth="110" />
                                        </StackPanel>
                                    </Border>

                                    <!-- 5. Textures Capsule: Dither Pattern (Pencil, DitherBrush, Fill, Gradient, Shapes) -->
                                    <Border Classes="context-chip" IsVisible="{Binding ToolViewModel.SupportsDitherPattern}">
                                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Loc[Context_Dither]}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" />
                                            <ComboBox ItemsSource="{Binding ToolViewModel.AvailablePatterns}"
                                                      SelectedItem="{Binding ToolViewModel.SelectedDitherPattern, Mode=TwoWay}"
                                                      Height="26" FontSize="11" VerticalContentAlignment="Center" MinWidth="130">
                                                <ComboBox.ItemTemplate>
                                                    <DataTemplate>
                                                        <TextBlock Text="{Binding Converter={StaticResource DitherLocalizationConverter}}" FontSize="11" />
                                                    </DataTemplate>
                                                </ComboBox.ItemTemplate>
                                            </ComboBox>
                                        </StackPanel>
                                    </Border>

                                    <!-- 6. Flood Fill Settings Capsule: Tolerance & Contiguous (Fill, MagicWand) -->
                                    <Border Classes="context-chip" IsVisible="{Binding ToolViewModel.SupportsFillSettings}">
                                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Loc[Context_Tolerance]}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" />
                                            <NumericUpDown Value="{Binding ToolViewModel.FillTolerance, Mode=TwoWay}"
                                                           Minimum="0" Maximum="100" Increment="5" FormatString="{}{0}%"
                                                           Height="26" Width="76" FontSize="11" VerticalContentAlignment="Center" />
                                            <CheckBox IsChecked="{Binding ToolViewModel.FillContiguous, Mode=TwoWay}"
                                                      Content="{Binding Loc[Context_Contiguous]}" FontSize="11"
                                                      Foreground="{DynamicResource TextPrimaryBrush}"
                                                      ToolTip.Tip="{Binding Loc[Context_ContiguousTip]}" />
                                        </StackPanel>
                                    </Border>

                                    <!-- 7. Gradient Settings Capsule: Linear / Radial & Multi-stop Presets -->
                                    <Border Classes="context-chip" IsVisible="{Binding ToolViewModel.SupportsGradientSettings}">
                                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Loc[Context_Gradient]}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" />
                                            <ComboBox ItemsSource="{Binding ToolViewModel.AvailableGradientTypes}"
                                                      SelectedItem="{Binding ToolViewModel.GradientType, Mode=TwoWay}"
                                                      Height="26" FontSize="11" VerticalContentAlignment="Center" MinWidth="85" />
                                            <TextBlock Text="{Binding Loc[Context_Preset]}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" />
                                            <ComboBox ItemsSource="{Binding ToolViewModel.AvailableGradientPresets}"
                                                      SelectedItem="{Binding ToolViewModel.SelectedGradientPreset, Mode=TwoWay}"
                                                      Height="26" FontSize="11" VerticalContentAlignment="Center" MinWidth="130"
                                                      ToolTip.Tip="{Binding Loc[Context_PresetTip]}">
                                                <ComboBox.ItemTemplate>
                                                    <DataTemplate>
                                                        <TextBlock Text="{Binding Name}" FontSize="11" />
                                                    </DataTemplate>
                                                </ComboBox.ItemTemplate>
                                            </ComboBox>
                                            <Button Content="{Binding Loc[Context_Ramp]}" Command="{Binding OpenColorRampDialogCommand}"
                                                    Height="26" Padding="8,2" FontSize="11"
                                                    Background="{DynamicResource SurfaceCardHoverBrush}"
                                                    BorderBrush="{DynamicResource BorderSubtleBrush}"
                                                    BorderThickness="1" CornerRadius="4"
                                                    ToolTip.Tip="{Binding Loc[Context_RampTip]}" />
                                        </StackPanel>
                                    </Border>

                                    <!-- 8. Shape Fill Capsule: Filled Shapes (Rectangle, Ellipse) -->
                                    <Border Classes="context-chip" IsVisible="{Binding ToolViewModel.SupportsShapeFill}">
                                        <CheckBox IsChecked="{Binding ToolViewModel.IsShapeFilled, Mode=TwoWay}"
                                                  Content="{Binding Loc[Context_ShapeFill]}" FontSize="11"
                                                  Foreground="{DynamicResource TextPrimaryBrush}" />
                                    </Border>
                                </WrapPanel>
                            </ScrollViewer>
                        </Grid>
                    </Border>

                    <!-- Canvas Area (Clean, Unobstructed Viewport) -->
                    <Grid Grid.Row="1">
                        <!-- Interactive SkiaSharp Canvas Control with ContextMenu -->
                        <controls:PixelCanvasControl Name="MainCanvasControl"
                                                    CanvasViewModel="{Binding CanvasViewModel}"
                                                    ToolViewModel="{Binding ToolViewModel}"
                                                    PaletteViewModel="{Binding PaletteViewModel}"
                                                    HistoryViewModel="{Binding HistoryViewModel}"
                                                    IsTiledMode="{Binding IsTiledMode, Mode=TwoWay}"
                                                    HorizontalAlignment="Stretch"
                                                    VerticalAlignment="Stretch">
                            <controls:PixelCanvasControl.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="{Binding Loc[Menu_Cut]}" HotKey="Ctrl+X" Command="{Binding CutCommand}" />
                                    <MenuItem Header="{Binding Loc[Menu_Copy]}" HotKey="Ctrl+C" Command="{Binding CopyCommand}" />
                                    <MenuItem Header="{Binding Loc[Menu_Paste]}" HotKey="Ctrl+V" Command="{Binding PasteCommand}" />
                                    <Separator />
                                    <MenuItem Header="{Binding Loc[Menu_SelectAll]}" HotKey="Ctrl+A" Command="{Binding SelectAllCommand}" />
                                    <MenuItem Header="{Binding Loc[Menu_Deselect]}" HotKey="Ctrl+D" Command="{Binding DeselectCommand}" />
                                    <MenuItem Header="{Binding Loc[Menu_DeleteSelection]}" HotKey="Delete" Command="{Binding DeleteSelectionOrClearLayerCommand}" />
                                    <Separator />
                                    <MenuItem Header="{Binding Loc[Menu_FlipLayerH]}" Command="{Binding FlipActiveLayerHorizontalCommand}" />
                                    <MenuItem Header="{Binding Loc[Menu_FlipLayerV]}" Command="{Binding FlipActiveLayerVerticalCommand}" />
                                    <MenuItem Header="{Binding Loc[Menu_RotateLayerCW]}" Command="{Binding RotateActiveLayerCWCommand}" />
                                    <Separator />
                                    <MenuItem Header="{Binding Loc[Menu_AddOutline]}" Command="{Binding AddOutlineCommand}" />
                                    <MenuItem Header="{Binding Loc[Menu_AddShadow]}" Command="{Binding AddShadowCommand}" />
                                </ContextMenu>
                            </controls:PixelCanvasControl.ContextMenu>
                        </controls:PixelCanvasControl>
                    </Grid>
                </Grid>
            </Border>

            <!-- Column 2: GridSplitter between Canvas and Inspector -->
            <GridSplitter Grid.Column="2" Width="4" Background="Transparent"
                          ResizeDirection="Columns" ShowsPreview="False" />

            <!-- Column 3: Right Inspector Column (Collapsible Accordion Panels & Independent Layers List) -->
            <Border Grid.Column="3" Background="{DynamicResource SurfacePanelBrush}"
                    BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1,0,0,0"
                    MinWidth="260" MaxWidth="500" Padding="8">
                <Grid RowDefinitions="Auto,Auto,Auto,*">
                    <!-- 1. Live Preview Collapsible Card -->
                    <Border Grid.Row="0" Background="{DynamicResource SurfaceCardBrush}"
                            BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1"
                            CornerRadius="8" Padding="6" Margin="0,0,0,6">
                        <Grid RowDefinitions="Auto,Auto">
                            <ToggleButton Name="PreviewCardToggle" IsChecked="True" Classes="inspector-card-header">
                                <Grid ColumnDefinitions="*,Auto">
                                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                        <PathIcon Data="{DynamicResource IconCrop}" Width="12" Height="12" Foreground="{DynamicResource AccentPrimaryBrush}" />
                                        <TextBlock Text="{Binding Loc[Panel_LivePreview], FallbackValue='ПРЕДПРОСМОТР 1X'}" FontSize="10" FontWeight="Bold"
                                                   Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" />
                                    </StackPanel>
                                    <Panel Grid.Column="1">
                                        <TextBlock Text="▾" IsVisible="{Binding #PreviewCardToggle.IsChecked}" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" />
                                        <TextBlock Text="▸" IsVisible="{Binding !#PreviewCardToggle.IsChecked}" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" />
                                    </Panel>
                                </Grid>
                            </ToggleButton>
                            <Panel Grid.Row="1" IsVisible="{Binding #PreviewCardToggle.IsChecked}" Margin="0,4,0,0">
                                <views:LivePreviewControl CanvasSource="{Binding CanvasViewModel.Canvas}" />
                            </Panel>
                        </Grid>
                    </Border>

                    <!-- 2. Color Picker & Palette Collapsible Card -->
                    <Border Grid.Row="1" Background="{DynamicResource SurfaceCardBrush}"
                            BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1"
                            CornerRadius="8" Padding="6" Margin="0,0,0,6">
                        <Grid RowDefinitions="Auto,Auto">
                            <ToggleButton Name="PaletteCardToggle" IsChecked="True" Classes="inspector-card-header">
                                <Grid ColumnDefinitions="*,Auto">
                                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                        <PathIcon Data="{DynamicResource IconPalette}" Width="12" Height="12" Foreground="{DynamicResource AccentPrimaryBrush}" />
                                        <TextBlock Text="{Binding Loc[Panel_ColorPicker], FallbackValue='ЦВЕТ И ПАЛИТРА'}" FontSize="10" FontWeight="Bold"
                                                   Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" />
                                    </StackPanel>
                                    <Panel Grid.Column="1">
                                        <TextBlock Text="▾" IsVisible="{Binding #PaletteCardToggle.IsChecked}" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" />
                                        <TextBlock Text="▸" IsVisible="{Binding !#PaletteCardToggle.IsChecked}" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" />
                                    </Panel>
                                </Grid>
                            </ToggleButton>
                            <Panel Grid.Row="1" IsVisible="{Binding #PaletteCardToggle.IsChecked}" Margin="0,4,0,0">
                                <views:ColorPickerView DataContext="{Binding PaletteViewModel}" />
                            </Panel>
                        </Grid>
                    </Border>

                    <!-- 3. Reference Image Overlay Collapsible Card -->
                    <Border Grid.Row="2" Background="{DynamicResource SurfaceCardBrush}"
                            BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1"
                            CornerRadius="8" Padding="6" Margin="0,0,0,6">
                        <Grid RowDefinitions="Auto,Auto">
                            <ToggleButton Name="ReferenceCardToggle" IsChecked="{Binding CanvasViewModel.ReferenceOverlay.HasImage}" Classes="inspector-card-header">
                                <Grid ColumnDefinitions="*,Auto">
                                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                        <PathIcon Data="{DynamicResource IconEye}" Width="12" Height="12" Foreground="{DynamicResource AccentPrimaryBrush}" />
                                        <TextBlock Text="{Binding Loc[Panel_Reference], FallbackValue='РЕФЕРЕНС'}" FontSize="10" FontWeight="Bold"
                                                   Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" />
                                    </StackPanel>
                                    <Panel Grid.Column="1">
                                        <TextBlock Text="▾" IsVisible="{Binding #ReferenceCardToggle.IsChecked}" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" />
                                        <TextBlock Text="▸" IsVisible="{Binding !#ReferenceCardToggle.IsChecked}" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" />
                                    </Panel>
                                </Grid>
                            </ToggleButton>
                            <Grid Grid.Row="1" RowDefinitions="Auto,Auto" IsVisible="{Binding #ReferenceCardToggle.IsChecked}" Margin="4,4,4,2">
                                <Grid Grid.Row="0" ColumnDefinitions="*,Auto">
                                    <TextBlock Grid.Column="0" Text="{Binding Loc[Ref_Overlay]}" FontSize="10"
                                               Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" />
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4">
                                        <ToggleButton IsChecked="{Binding CanvasViewModel.ReferenceOverlay.IsVisible, Mode=TwoWay}"
                                                      Classes="action-btn" Padding="4"
                                                      ToolTip.Tip="{Binding Loc[Ref_VisibilityTip]}">
                                            <Panel>
                                                <PathIcon Data="{DynamicResource IconEye}" Width="12" Height="12"
                                                          IsVisible="{Binding CanvasViewModel.ReferenceOverlay.IsVisible}"
                                                          Foreground="{DynamicResource AccentPrimaryBrush}" />
                                                <PathIcon Data="{DynamicResource IconEyeOff}" Width="12" Height="12"
                                                          IsVisible="{Binding !CanvasViewModel.ReferenceOverlay.IsVisible}"
                                                          Foreground="{DynamicResource TextMutedBrush}" />
                                            </Panel>
                                        </ToggleButton>
                                        <Button Classes="action-btn" Command="{Binding LoadReferenceImageCommand}"
                                                ToolTip.Tip="{Binding Loc[Ref_LoadTip]}" Padding="4">
                                            <PathIcon Data="{DynamicResource IconFolderOpen}" Width="12" Height="12" Foreground="{DynamicResource TextPrimaryBrush}" />
                                        </Button>
                                        <Button Classes="action-btn" Command="{Binding ClearReferenceImageCommand}"
                                                ToolTip.Tip="{Binding Loc[Ref_ClearTip]}" Padding="4"
                                                IsEnabled="{Binding CanvasViewModel.ReferenceOverlay.HasImage}">
                                            <PathIcon Data="{DynamicResource IconDelete}" Width="12" Height="12" Foreground="{DynamicResource AccentDangerBrush}" />
                                        </Button>
                                    </StackPanel>
                                </Grid>
                                <Grid Grid.Row="1" ColumnDefinitions="Auto,*,36" Margin="0,6,0,0"
                                      IsVisible="{Binding CanvasViewModel.ReferenceOverlay.HasImage}">
                                    <TextBlock Grid.Column="0" Text="{Binding Loc[Ref_Opacity]}" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,6,0" />
                                    <Slider Grid.Column="1" Minimum="0" Maximum="1" Value="{Binding CanvasViewModel.ReferenceOverlay.Opacity, Mode=TwoWay}"
                                            VerticalAlignment="Center" Margin="0,0,4,0" />
                                    <TextBlock Grid.Column="2" Text="{Binding CanvasViewModel.ReferenceOverlay.Opacity, StringFormat='{}{0:P0}'}"
                                               FontSize="10" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}" />
                                </Grid>
                            </Grid>
                        </Grid>
                    </Border>

                    <!-- 4. Layers Manager Panel (Takes All Remaining Height) -->
                    <Border Grid.Row="3" Background="{DynamicResource SurfaceCardBrush}"
                            BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1"
                            CornerRadius="8" Padding="10"
                            MinHeight="180">
                        <Grid RowDefinitions="Auto,Auto,*">
                            <!-- Layer Manager Header -->
                            <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,6">
                                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                    <PathIcon Data="{DynamicResource IconLayers}" Width="14" Height="14" Foreground="{DynamicResource AccentPrimaryBrush}" />
                                    <TextBlock Text="{Binding Loc[Panel_Layers]}" FontSize="11" FontWeight="Bold"
                                               Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" />
                                </StackPanel>

                                <!-- Layer Actions -->
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="3">
                                    <Button Classes="action-btn" Command="{Binding LayerViewModel.AddLayerCommand}" ToolTip.Tip="{Binding Loc[Layer_AddTip]}">
                                        <PathIcon Data="{DynamicResource IconAdd}" Width="13" Height="13" Foreground="{DynamicResource TextPrimaryBrush}" />
                                    </Button>
                                    <Button Classes="action-btn" Command="{Binding LayerViewModel.DuplicateLayerCommand}" ToolTip.Tip="{Binding Loc[Layer_DuplicateTip]}">
                                        <PathIcon Data="{DynamicResource IconNewFile}" Width="13" Height="13" Foreground="{DynamicResource TextPrimaryBrush}" />
                                    </Button>
                                    <Button Classes="action-btn" Command="{Binding LayerViewModel.MoveUpCommand}" ToolTip.Tip="{Binding Loc[Layer_MoveUpTip]}">
                                        <PathIcon Data="{DynamicResource IconArrowUp}" Width="13" Height="13" Foreground="{DynamicResource TextPrimaryBrush}" />
                                    </Button>
                                    <Button Classes="action-btn" Command="{Binding LayerViewModel.MoveDownCommand}" ToolTip.Tip="{Binding Loc[Layer_MoveDownTip]}">
                                        <PathIcon Data="{DynamicResource IconArrowDown}" Width="13" Height="13" Foreground="{DynamicResource TextPrimaryBrush}" />
                                    </Button>
                                    <Button Classes="action-btn" Command="{Binding LayerViewModel.MergeDownCommand}" ToolTip.Tip="{Binding Loc[Layer_MergeDownTip]}">
                                        <PathIcon Data="{DynamicResource IconMergeDown}" Width="13" Height="13" Foreground="{DynamicResource TextPrimaryBrush}" />
                                    </Button>
                                    <Button Classes="action-btn" Command="{Binding LayerViewModel.RemoveLayerCommand}" ToolTip.Tip="{Binding Loc[Layer_DeleteTip]}">
                                        <PathIcon Data="{DynamicResource IconDelete}" Width="13" Height="13" Foreground="{DynamicResource AccentDangerBrush}" />
                                    </Button>
                                </StackPanel>
                            </Grid>

                            <!-- Layer Opacity Slider -->
                            <Grid Grid.Row="1" ColumnDefinitions="Auto,*,36" Margin="0,0,0,6">
                                <TextBlock Grid.Column="0" Text="{Binding Loc[Layer_Opacity]}" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,6,0" />
                                <Slider Grid.Column="1" Minimum="0" Maximum="1" Value="{Binding LayerViewModel.ActiveLayer.Opacity, FallbackValue=1}"
                                        VerticalAlignment="Center" Margin="0,0,4,0" />
                                <TextBlock Grid.Column="2" Text="{Binding LayerViewModel.ActiveLayer.Opacity, StringFormat='{}{0:P0}', FallbackValue='100%'}"
                                           FontSize="10" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}" />
                            </Grid>

                            <!-- Layers ListBox with Virtualization & Independent ScrollViewer -->
                            <ListBox Grid.Row="2" ItemsSource="{Binding LayerViewModel.Layers}"
                                     SelectedItem="{Binding LayerViewModel.ActiveLayer, Mode=TwoWay}"
                                     Background="Transparent" BorderThickness="0"
                                     ScrollViewer.VerticalScrollBarVisibility="Auto">
                                <ListBox.ItemTemplate>
                                    <DataTemplate x:DataType="models:Layer">
                                        <Grid ColumnDefinitions="Auto,Auto,*,Auto" Height="28">
                                            <!-- Visibility Toggle Button -->
                                            <Button Grid.Column="0" Classes="action-btn" Padding="4"
                                                    Command="{Binding #RootWindow.DataContext.LayerViewModel.ToggleVisibilityCommand}"
                                                    CommandParameter="{Binding}"
                                                    ToolTip.Tip="{Binding #RootWindow.DataContext.Loc[Layer_VisibilityTip]}">
                                                <Panel>
                                                    <PathIcon Data="{DynamicResource IconEye}" Width="13" Height="13"
                                                              IsVisible="{Binding IsVisible}"
                                                              Foreground="{DynamicResource AccentPrimaryBrush}" />
                                                    <PathIcon Data="{DynamicResource IconEyeOff}" Width="13" Height="13"
                                                              IsVisible="{Binding !IsVisible}"
                                                              Foreground="{DynamicResource TextMutedBrush}" />
                                                </Panel>
                                            </Button>

                                            <!-- Alpha Lock Toggle Button -->
                                            <Button Grid.Column="1" Classes="action-btn" Padding="4" Margin="2,0,0,0"
                                                    Command="{Binding #RootWindow.DataContext.LayerViewModel.ToggleAlphaLockCommand}"
                                                    CommandParameter="{Binding}"
                                                    ToolTip.Tip="{Binding #RootWindow.DataContext.Loc[Layer_AlphaLockTip]}">
                                                <Panel>
                                                    <PathIcon Data="{DynamicResource IconLock}" Width="13" Height="13"
                                                              IsVisible="{Binding IsAlphaLocked}"
                                                              Foreground="{DynamicResource AccentPrimaryBrush}" />
                                                    <PathIcon Data="{DynamicResource IconLock}" Width="13" Height="13"
                                                              IsVisible="{Binding !IsAlphaLocked}"
                                                              Foreground="{DynamicResource TextMutedBrush}"
                                                              Opacity="0.4" />
                                                </Panel>
                                            </Button>

                                            <!-- Layer Name View Mode -->
                                            <TextBlock Grid.Column="2" Text="{Binding Name}" Margin="8,0"
                                                       VerticalAlignment="Center" FontSize="11"
                                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                                       TextTrimming="CharacterEllipsis"
                                                       IsVisible="{Binding !IsRenaming}"
                                                       DoubleTapped="OnLayerNameDoubleTapped"
                                                       ToolTip.Tip="Двойной клик для переименования" />

                                            <!-- Layer Name Inline Edit Mode -->
                                            <TextBox Grid.Column="2" Text="{Binding Name, Mode=TwoWay}" Margin="4,0"
                                                     Height="24" FontSize="11" Padding="4,1"
                                                     VerticalAlignment="Center"
                                                     IsVisible="{Binding IsRenaming}"
                                                     LostFocus="OnLayerNameTextBoxLostFocus"
                                                     KeyDown="OnLayerNameTextBoxKeyDown" />

                                            <!-- Opacity text -->
                                            <TextBlock Grid.Column="3" Text="{Binding Opacity, StringFormat='{}{0:P0}'}"
                                                       VerticalAlignment="Center" FontSize="10"
                                                       Foreground="{DynamicResource TextMutedBrush}" />
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Grid>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <!-- 5. Bottom: StatusBar (Modern Capsule Design with Active Modes & Enhanced Indicators) -->
        <Border Grid.Row="4" Background="{DynamicResource SurfacePanelBrush}"
                BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="0,1,0,0"
                Height="30" Padding="10,0">
            <Grid ColumnDefinitions="*,Auto,Auto">
                <!-- Left: Status Message & Active Mode Indicators -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                    <!-- Status dot + message -->
                    <Border Width="6" Height="6" CornerRadius="3" Background="{DynamicResource AccentSuccessBrush}"
                            VerticalAlignment="Center" ToolTip.Tip="{Binding Loc[Status_Ready]}" />
                    <TextBlock Text="{Binding StatusMessage}"
                               VerticalAlignment="Center" FontSize="11"
                               Foreground="{DynamicResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis" MaxWidth="180" />

                    <!-- Active Mode Indicators (Capsules) -->
                    <!-- Tiled Mode (F10) -->
                    <Button Classes="status-capsule-btn"
                            IsVisible="{Binding IsTiledMode}"
                            Command="{Binding ToggleTiledModeCommand}"
                            Background="{DynamicResource AccentGlowBrush}"
                            BorderBrush="{DynamicResource AccentPrimaryBrush}"
                            Height="22" Padding="6,1" VerticalAlignment="Center"
                            ToolTip.Tip="{Binding Loc[Status_TiledActiveTip]}">
                        <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                            <PathIcon Data="{DynamicResource IconTiled}" Width="11" Height="11" Foreground="{DynamicResource AccentPrimaryBrush}" />
                            <TextBlock Text="TILED 3×3" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource AccentPrimaryBrush}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <!-- Symmetry Mode (Shift+X / Shift+Y) -->
                    <Button Classes="status-capsule-btn"
                            IsVisible="{Binding CanvasViewModel.HasActiveSymmetry}"
                            Command="{Binding CanvasViewModel.ToggleSymmetryXCommand}"
                            Background="{DynamicResource AccentGlowBrush}"
                            BorderBrush="{DynamicResource AccentSecondaryBrush}"
                            Height="22" Padding="6,1" VerticalAlignment="Center"
                            ToolTip.Tip="{Binding Loc[Status_SymmetryTip]}">
                        <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                            <PathIcon Data="{DynamicResource IconSymmetryX}" Width="11" Height="11" Foreground="{DynamicResource AccentSecondaryBrush}" />
                            <TextBlock Text="{Binding CanvasViewModel.SymmetryStatusText}" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource AccentSecondaryBrush}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <!-- Pixel-Perfect Mode (Shift+P) -->
                    <Button Classes="status-capsule-btn"
                            IsVisible="{Binding ToolViewModel.IsPixelPerfectActive}"
                            Command="{Binding ToolViewModel.TogglePixelPerfectCommand}"
                            Height="22" Padding="6,1" VerticalAlignment="Center"
                            ToolTip.Tip="{Binding Loc[Status_PixelPerfectTip]}">
                        <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                            <PathIcon Data="{DynamicResource IconPixelPerfect}" Width="11" Height="11" Foreground="{DynamicResource AccentPrimaryBrush}" />
                            <TextBlock Text="PIXEL-PERFECT" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource AccentPrimaryBrush}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <!-- Alpha-Lock on Active Layer -->
                    <Button Classes="status-capsule-btn"
                            IsVisible="{Binding LayerViewModel.IsActiveLayerAlphaLocked}"
                            Command="{Binding LayerViewModel.ToggleAlphaLockCommand}"
                            Height="22" Padding="6,1" VerticalAlignment="Center"
                            ToolTip.Tip="{Binding Loc[Status_AlphaLockTip]}">
                        <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                            <PathIcon Data="{DynamicResource IconLock}" Width="10" Height="10" Foreground="{DynamicResource AccentPrimaryBrush}" />
                            <TextBlock Text="ALPHA-LOCK" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource AccentPrimaryBrush}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </StackPanel>

                <!-- Center: Mouse Shortcuts Hint Capsule (Responsive hiding on narrow screens) -->
                <Border Name="MouseHintsBadge" Grid.Column="1" Margin="4,0" Padding="8,2" VerticalAlignment="Center" Height="22"
                        Classes="status-capsule-badge" IsHitTestVisible="False">
                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                        <!-- LMB -->
                        <StackPanel Orientation="Horizontal" Spacing="3" VerticalAlignment="Center">
                            <Border Background="{DynamicResource SurfaceChipBrush}" CornerRadius="3" Padding="4,1">
                                <TextBlock Text="{Binding Loc[Hud_Lmb]}" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource AccentPrimaryBrush}" />
                            </Border>
                            <TextBlock Text="{Binding Loc[Hud_Draw]}" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" />
                        </StackPanel>

                        <TextBlock Text="•" FontSize="9" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" />

                        <!-- RMB -->
                        <StackPanel Orientation="Horizontal" Spacing="3" VerticalAlignment="Center">
                            <Border Background="{DynamicResource SurfaceChipBrush}" CornerRadius="3" Padding="4,1">
                                <TextBlock Text="{Binding Loc[Hud_Rmb]}" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource AccentSecondaryBrush}" />
                            </Border>
                            <TextBlock Text="{Binding Loc[Hud_EraseSecondary]}" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" />
                        </StackPanel>

                        <TextBlock Text="•" FontSize="9" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" />

                        <!-- Space + Drag -->
                        <StackPanel Orientation="Horizontal" Spacing="3" VerticalAlignment="Center">
                            <Border Background="{DynamicResource SurfaceChipBrush}" CornerRadius="3" Padding="4,1">
                                <TextBlock Text="{Binding Loc[Hud_SpaceDrag]}" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" />
                            </Border>
                            <TextBlock Text="{Binding Loc[Hud_Pan]}" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" />
                        </StackPanel>

                        <TextBlock Text="•" FontSize="9" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" />

                        <!-- Ctrl + Wheel -->
                        <StackPanel Orientation="Horizontal" Spacing="3" VerticalAlignment="Center">
                            <Border Background="{DynamicResource SurfaceChipBrush}" CornerRadius="3" Padding="4,1">
                                <TextBlock Text="{Binding Loc[Hud_CtrlWheel]}" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" />
                            </Border>
                            <TextBlock Text="{Binding Loc[Hud_Zoom]}" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Right: Dimensions, Tile Grid, Zoom, Language, Selection, Coordinates -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                    <!-- Selection Indicator Capsule (Active when canvas selection exists) -->
                    <Button Classes="status-capsule-btn"
                            IsVisible="{Binding CanvasViewModel.HasActiveSelection}"
                            Command="{Binding DeselectCommand}"
                            Height="22" Padding="7,2" VerticalAlignment="Center"
                            ToolTip.Tip="{Binding Loc[Status_SelectionTip]}">
                        <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                            <PathIcon Data="{DynamicResource IconSelection}" Width="11" Height="11" Foreground="{DynamicResource AccentPrimaryBrush}" />
                            <TextBlock Text="{Binding CanvasViewModel.SelectionShortText, StringFormat='{}Sel: {0}'}" FontSize="11" FontWeight="SemiBold"
                                       Foreground="{DynamicResource AccentPrimaryBrush}" VerticalAlignment="Center" />
                            <TextBlock Text="✕" FontSize="9" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" Margin="2,0,0,0" />
                        </StackPanel>
                    </Button>

                    <!-- Canvas Dimensions Capsule (Interactive Button -> opens ResizeCanvasDialog) -->
                    <Button Name="StatusDimensionsButton" Padding="8,2" VerticalAlignment="Center"
                            Height="22" Classes="status-capsule-btn"
                            ToolTip.Tip="{Binding Loc[Status_DimensionsTip]}">
                        <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                            <PathIcon Data="{DynamicResource IconCrop}" Width="12" Height="12" Foreground="{DynamicResource AccentPrimaryBrush}" />
                            <TextBlock Text="{Binding CanvasViewModel.DimensionsText}" FontSize="11" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <!-- Tile Grid Capsule: Toggle & Cycle Size -->
                    <Border Padding="4,1" VerticalAlignment="Center" Height="22"
                            Classes="status-capsule-badge">
                        <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                            <ToggleButton Classes="status-capsule-toggle"
                                          IsChecked="{Binding CanvasViewModel.ShowTileGrid, Mode=TwoWay}"
                                          ToolTip.Tip="{Binding Loc[Tip_TileGrid]}">
                                <StackPanel Orientation="Horizontal" Spacing="4">
                                    <PathIcon Data="{DynamicResource IconTileGrid}" Width="11" Height="11"
                                              Foreground="{DynamicResource AccentPrimaryBrush}" />
                                    <TextBlock Text="{Binding Loc[Context_TileGrid]}" FontSize="10" VerticalAlignment="Center" />
                                </StackPanel>
                            </ToggleButton>
                            <Separator Width="1" Height="12" Background="{DynamicResource BorderSubtleBrush}" />
                            <Button Command="{Binding CanvasViewModel.CycleTileGridSizeCommand}"
                                    Background="Transparent" BorderThickness="0" Padding="4,1" Height="20"
                                    CornerRadius="3"
                                    ToolTip.Tip="{Binding Loc[Context_TileSize]}">
                                <TextBlock Text="{Binding CanvasViewModel.TileGridText}" FontSize="10" FontWeight="SemiBold"
                                           Foreground="{DynamicResource AccentPrimaryBrush}" VerticalAlignment="Center" />
                            </Button>
                        </StackPanel>
                    </Border>

                    <!-- Zoom Level Interactive Capsule Button (Click to cycle preset zoom levels) -->
                    <Button Classes="status-capsule-btn" Padding="8,2" VerticalAlignment="Center" Height="22"
                            Command="{Binding CanvasViewModel.CycleZoomPresetCommand}"
                            ToolTip.Tip="{Binding Loc[Status_ZoomTip]}">
                        <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Loc[Status_Zoom]}" FontSize="10" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding CanvasViewModel.ZoomText}" FontSize="11" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <!-- Language Switcher Capsule Button -->
                    <Button Padding="8,2" VerticalAlignment="Center" Height="22"
                            Classes="status-capsule-btn"
                            Command="{Binding ToggleLanguageCommand}"
                            ToolTip.Tip="{Binding Loc[Status_LangButtonTip]}">
                        <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                            <TextBlock Text="🌐" FontSize="10" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding Loc[Status_LangButton]}" FontSize="10" FontWeight="Bold"
                                       Foreground="{DynamicResource AccentPrimaryBrush}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <!-- Cursor Coordinates & Color under cursor Capsule Badge -->
                    <Border Padding="8,2" VerticalAlignment="Center" Height="22"
                            Classes="status-capsule-badge"
                            ToolTip.Tip="{Binding CanvasViewModel.HoveredColorHex}">
                        <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                            <TextBlock Text="✛" FontSize="11" Foreground="{DynamicResource AccentPrimaryBrush}" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding CanvasViewModel.CursorCoordinatesText}" FontSize="11" FontWeight="SemiBold"
                                       Foreground="{DynamicResource AccentPrimaryBrush}" VerticalAlignment="Center" />
                            <!-- Hovered Pixel Color Preview Dot (Visible when hovering over canvas) -->
                            <Border Width="10" Height="10" CornerRadius="3"
                                    IsVisible="{Binding CanvasViewModel.HasHoveredColor}"
                                    Background="{Binding CanvasViewModel.HoveredColor, Converter={StaticResource PixelColorConverter}}"
                                    BorderBrush="{DynamicResource BorderStrongBrush}" BorderThickness="1"
                                    VerticalAlignment="Center" Margin="1,0,0,0" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
