<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        x:Class="PixelForge.App.Views.SplashWindow"
        Title="PixelForge"
        Icon="/Assets/icon.ico"
        Width="600" Height="360"
        CanResize="False"
        SystemDecorations="None"
        WindowStartupLocation="CenterScreen"
        Topmost="True"
        Background="Transparent"
        TransparencyLevelHint="Transparent">

    <Border Background="#12131C"
            BorderBrush="#2A3045"
            BorderThickness="1.5"
            CornerRadius="14"
            BoxShadow="0 18 48 0 #80000000"
            ClipToBounds="True">
        <Grid RowDefinitions="*,Auto">
            <!-- Decorative Background Glow -->
            <Canvas Grid.RowSpan="2" IsHitTestVisible="False">
                <Ellipse Width="320" Height="240"
                         Canvas.Left="-60" Canvas.Top="-60"
                         Opacity="0.12">
                    <Ellipse.Fill>
                        <RadialGradientBrush Center="50%,50%" GradientOrigin="50%,50%" RadiusX="50%" RadiusY="50%">
                            <GradientStop Color="#00D2FF" Offset="0" />
                            <GradientStop Color="Transparent" Offset="1" />
                        </RadialGradientBrush>
                    </Ellipse.Fill>
                </Ellipse>
                <Ellipse Width="280" Height="200"
                         Canvas.Right="-40" Canvas.Bottom="20"
                         Opacity="0.08">
                    <Ellipse.Fill>
                        <RadialGradientBrush Center="50%,50%" GradientOrigin="50%,50%" RadiusX="50%" RadiusY="50%">
                            <GradientStop Color="#818CF8" Offset="0" />
                            <GradientStop Color="Transparent" Offset="1" />
                        </RadialGradientBrush>
                    </Ellipse.Fill>
                </Ellipse>
            </Canvas>

            <!-- Main Content Area -->
            <StackPanel Grid.Row="0" Margin="36,32,36,16" Spacing="18">
                <!-- Branding Header -->
                <Grid ColumnDefinitions="Auto,*,Auto" VerticalAlignment="Center">
                    <Image Grid.Column="0"
                           Source="/Assets/icon.png"
                           Width="64" Height="64"
                           Margin="0,0,16,0"
                           VerticalAlignment="Center" />

                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                        <TextBlock Text="PixelForge"
                                   FontSize="28"
                                   FontWeight="Bold"
                                   Foreground="#F8FAFC"
                                   LetterSpacing="0.5" />
                        <TextBlock Text="PROFESSIONAL PIXEL ART STUDIO"
                                   FontSize="11"
                                   FontWeight="SemiBold"
                                   Foreground="#00D2FF"
                                   LetterSpacing="1.2" />
                    </StackPanel>

                    <!-- Version Badge -->
                    <Border Grid.Column="2"
                            Background="#1E2333"
                            BorderBrush="#313952"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="8,4"
                            VerticalAlignment="Center">
                        <TextBlock Text="v0.1.0"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   Foreground="#38BDF8" />
                    </Border>
                </Grid>

                <Separator Background="#22283A" Height="1" Margin="0,4" />

                <!-- Feature Highlights -->
                <StackPanel Spacing="8">
                    <Grid ColumnDefinitions="Auto,*">
                        <TextBlock Grid.Column="0" Text="◆" Foreground="#00D2FF" Margin="0,0,8,0" FontSize="11" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1" Text="Hardware-Accelerated 60+ FPS SkiaSharp Render Pipeline"
                                   FontSize="12" Foreground="#CBD5E1" VerticalAlignment="Center" />
                    </Grid>
                    <Grid ColumnDefinitions="Auto,*">
                        <TextBlock Grid.Column="0" Text="◆" Foreground="#38BDF8" Margin="0,0,8,0" FontSize="11" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1" Text="Full RAM Working Set resident execution (Zero disk-paging latency)"
                                   FontSize="12" Foreground="#CBD5E1" VerticalAlignment="Center" />
                    </Grid>
                    <Grid ColumnDefinitions="Auto,*">
                        <TextBlock Grid.Column="0" Text="◆" Foreground="#818CF8" Margin="0,0,8,0" FontSize="11" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1" Text="Pre-JIT compiled rendering hot paths and sparse delta undo engine"
                                   FontSize="12" Foreground="#CBD5E1" VerticalAlignment="Center" />
                    </Grid>
                </StackPanel>
            </StackPanel>

            <!-- Bottom Progress & Real-Time Loading Status -->
            <Border Grid.Row="1"
                    Background="#161924"
                    BorderBrush="#252A3C"
                    BorderThickness="0,1,0,0"
                    Padding="36,16,36,20">
                <StackPanel Spacing="10">
                    <!-- Status Labels & Percentage -->
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Name="StatusText"
                                   Grid.Column="0"
                                   Text="Initializing PixelForge Core Subsystems..."
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   Foreground="#F8FAFC"
                                   TextTrimming="CharacterEllipsis" />
                        <TextBlock Name="PercentText"
                                   Grid.Column="1"
                                   Text="0%"
                                   FontSize="12"
                                   FontWeight="Bold"
                                   Foreground="#00D2FF" />
                    </Grid>

                    <!-- Sub-Detail Text -->
                    <TextBlock Name="DetailText"
                               Text="Starting components..."
                               FontSize="11"
                               Foreground="#8592A6"
                               TextTrimming="CharacterEllipsis" />

                    <!-- Sleek Gradient Progress Bar -->
                    <ProgressBar Name="ProgressBar"
                                 Minimum="0" Maximum="100" Value="0"
                                 Height="5"
                                 CornerRadius="2.5"
                                 Background="#22283A"
                                 Foreground="#00D2FF" />

                    <!-- Bottom Copyright / Platform Note -->
                    <TextBlock Text="© 2026 widlily-corp • High-Performance .NET 8 / Avalonia 11 Engine"
                               FontSize="10"
                               Foreground="#4E596F"
                               HorizontalAlignment="Right"
                               Margin="0,2,0,0" />
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
