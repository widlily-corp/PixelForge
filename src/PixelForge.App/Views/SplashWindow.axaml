<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        x:Class="PixelForge.App.Views.SplashWindow"
        Title="PixelForge"
        Icon="/Assets/icon.ico"
        Width="620" Height="440"
        CanResize="False"
        SystemDecorations="None"
        WindowStartupLocation="CenterScreen"
        Topmost="True"
        Background="Transparent"
        TransparencyLevelHint="Transparent">

    <Border Background="#10131E"
            BorderBrush="#2A334E"
            BorderThickness="1.5"
            CornerRadius="16"
            BoxShadow="0 24 64 0 #90000000"
            ClipToBounds="True">
        <Grid RowDefinitions="Auto,Auto,*,Auto">
            <!-- 1. Hero Pixel Art Artwork Banner -->
            <Border Grid.Row="0" Height="170" ClipToBounds="True" Background="#0A0D18">
                <Panel>
                    <Image Source="/Assets/splash_art.png"
                           Stretch="UniformToFill"
                           RenderOptions.BitmapInterpolationMode="None" />

                    <!-- Bottom gradient fade into header -->
                    <Border VerticalAlignment="Bottom" Height="50">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
                                <GradientStop Color="Transparent" Offset="0" />
                                <GradientStop Color="#10131E" Offset="1" />
                            </LinearGradientBrush>
                        </Border.Background>
                    </Border>
                </Panel>
            </Border>

            <!-- 2. Branding Header -->
            <Grid Grid.Row="1" ColumnDefinitions="Auto,*,Auto" Margin="28,12,28,8" VerticalAlignment="Center">
                <Border Grid.Column="0" Width="48" Height="48" CornerRadius="10"
                        Background="#191E2E" BorderBrush="#2C3550" BorderThickness="1"
                        Margin="0,0,14,0" VerticalAlignment="Center">
                    <Image Source="/Assets/icon.png" Width="36" Height="36" VerticalAlignment="Center" HorizontalAlignment="Center" />
                </Border>

                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                    <TextBlock Text="PixelForge"
                               FontSize="24"
                               FontWeight="Bold"
                               Foreground="#F8FAFC"
                               LetterSpacing="0.5" />
                    <TextBlock Name="SubtitleText"
                               Text="PROFESSIONAL PIXEL ART STUDIO"
                               FontSize="10"
                               FontWeight="Bold"
                               Foreground="#00D2FF"
                               LetterSpacing="1.2" />
                </StackPanel>

                <!-- Version Badge -->
                <Border Grid.Column="2"
                        Background="#1A2032"
                        BorderBrush="#2F3A58"
                        BorderThickness="1"
                        CornerRadius="6"
                        Padding="10,4"
                        VerticalAlignment="Center">
                    <TextBlock Name="VersionBadgeText" Text="v0.1.5"
                               FontSize="12"
                               FontWeight="Bold"
                               Foreground="#38BDF8" />
                </Border>
            </Grid>

            <!-- 3. Key Feature Badges Row -->
            <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="10" Margin="28,6,28,14" HorizontalAlignment="Center">
                <Border Background="#161B29" BorderBrush="#252D42" BorderThickness="1" CornerRadius="6" Padding="8,4">
                    <StackPanel Orientation="Horizontal" Spacing="5">
                        <TextBlock Text="◆" Foreground="#00D2FF" FontSize="10" VerticalAlignment="Center" />
                        <TextBlock Name="Feature1Text" Text="SkiaSharp 60+ FPS" FontSize="11" Foreground="#CBD5E1" VerticalAlignment="Center" />
                    </StackPanel>
                </Border>
                <Border Background="#161B29" BorderBrush="#252D42" BorderThickness="1" CornerRadius="6" Padding="8,4">
                    <StackPanel Orientation="Horizontal" Spacing="5">
                        <TextBlock Text="◆" Foreground="#818CF8" FontSize="10" VerticalAlignment="Center" />
                        <TextBlock Name="Feature2Text" Text="Zero-Latency RAM Resident" FontSize="11" Foreground="#CBD5E1" VerticalAlignment="Center" />
                    </StackPanel>
                </Border>
                <Border Background="#161B29" BorderBrush="#252D42" BorderThickness="1" CornerRadius="6" Padding="8,4">
                    <StackPanel Orientation="Horizontal" Spacing="5">
                        <TextBlock Text="◆" Foreground="#38BDF8" FontSize="10" VerticalAlignment="Center" />
                        <TextBlock Name="Feature3Text" Text="Sparse Undo &amp; References" FontSize="11" Foreground="#CBD5E1" VerticalAlignment="Center" />
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- 4. Bottom Progress & Real-Time Loading Status -->
            <Border Grid.Row="3"
                    Background="#141825"
                    BorderBrush="#22283A"
                    BorderThickness="0,1,0,0"
                    Padding="28,14,28,18">
                <StackPanel Spacing="8">
                    <!-- Status Labels & Percentage -->
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Name="StatusText"
                                   Grid.Column="0"
                                   Text="Initializing PixelForge Core Subsystems..."
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   Foreground="#F8FAFC"
                                   TextTrimming="CharacterEllipsis" />
                        <TextBlock Name="PercentText"
                                   Grid.Column="1"
                                   Text="0%"
                                   FontSize="12"
                                   FontWeight="Bold"
                                   Foreground="#00D2FF" />
                    </Grid>

                    <!-- Sub-Detail Text -->
                    <TextBlock Name="DetailText"
                               Text="Starting components..."
                               FontSize="11"
                               Foreground="#8592A6"
                               TextTrimming="CharacterEllipsis" />

                    <!-- Sleek Gradient Progress Bar -->
                    <ProgressBar Name="ProgressBar"
                                 Minimum="0" Maximum="100" Value="0"
                                 Height="5"
                                 CornerRadius="2.5"
                                 Background="#1F263A"
                                 Foreground="#00D2FF" />

                    <!-- Bottom Copyright / Platform Note -->
                    <TextBlock Text="© 2026 widlily-corp • High-Performance .NET 8 / Avalonia 11 Engine"
                               FontSize="10"
                               Foreground="#4E596F"
                               HorizontalAlignment="Right"
                               Margin="0,2,0,0" />
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
