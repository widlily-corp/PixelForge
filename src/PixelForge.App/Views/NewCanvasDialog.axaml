<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="400" d:DesignHeight="360"
        x:Class="PixelForge.App.Views.NewCanvasDialog"
        Title="Новый холст — PixelForge"
        Width="400" Height="360"
        CanResize="False"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource SurfaceBaseBrush}">

    <Border Padding="24">
        <Grid RowDefinitions="Auto,Auto,Auto,*,Auto">
            <!-- Header -->
            <StackPanel Grid.Row="0" Spacing="4" Margin="0,0,0,16">
                <TextBlock Text="Новый холст" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" />
                <TextBlock Text="Выберите предустановку или укажите произвольный размер" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" />
            </StackPanel>

            <!-- Presets Section -->
            <StackPanel Grid.Row="1" Spacing="8" Margin="0,0,0,16">
                <TextBlock Text="БЫСТРЫЕ ПРЕСЕТЫ" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextMutedBrush}" />
                <Grid ColumnDefinitions="*,*,*">
                    <Button Name="Preset32Button" Grid.Column="0" Margin="0,0,4,0" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                            Padding="8,10" Background="{DynamicResource SurfaceCardBrush}" Foreground="{DynamicResource TextPrimaryBrush}"
                            BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="6">
                        <StackPanel Spacing="2" HorizontalAlignment="Center">
                            <TextBlock Text="32 × 32" FontWeight="SemiBold" HorizontalAlignment="Center" />
                            <TextBlock Text="Иконка" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <Button Name="Preset64Button" Grid.Column="1" Margin="4,0,4,0" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                            Padding="8,10" Background="{DynamicResource SurfaceCardBrush}" Foreground="{DynamicResource TextPrimaryBrush}"
                            BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="6">
                        <StackPanel Spacing="2" HorizontalAlignment="Center">
                            <TextBlock Text="64 × 64" FontWeight="SemiBold" HorizontalAlignment="Center" />
                            <TextBlock Text="Спрайт" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <Button Name="Preset128Button" Grid.Column="2" Margin="4,0,0,0" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                            Padding="8,10" Background="{DynamicResource SurfaceCardBrush}" Foreground="{DynamicResource TextPrimaryBrush}"
                            BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="6">
                        <StackPanel Spacing="2" HorizontalAlignment="Center">
                            <TextBlock Text="128 × 128" FontWeight="SemiBold" HorizontalAlignment="Center" />
                            <TextBlock Text="Детальный арт" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </Grid>
            </StackPanel>

            <!-- Custom Size Section -->
            <StackPanel Grid.Row="2" Spacing="10" Margin="0,0,0,16">
                <TextBlock Text="ПРОИЗВОЛЬНЫЙ РАЗМЕР (16–256 px)" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextMutedBrush}" />
                <Grid ColumnDefinitions="*,16,*">
                    <StackPanel Grid.Column="0" Spacing="4">
                        <TextBlock Text="Ширина (px)" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" />
                        <NumericUpDown Name="WidthInput" Value="32" Minimum="16" Maximum="256" Increment="8"
                                       FormatString="0"
                                       Background="{DynamicResource SurfaceCardBrush}"
                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                       BorderBrush="{DynamicResource BorderSubtleBrush}" />
                    </StackPanel>

                    <StackPanel Grid.Column="2" Spacing="4">
                        <TextBlock Text="Высота (px)" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" />
                        <NumericUpDown Name="HeightInput" Value="32" Minimum="16" Maximum="256" Increment="8"
                                       FormatString="0"
                                       Background="{DynamicResource SurfaceCardBrush}"
                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                       BorderBrush="{DynamicResource BorderSubtleBrush}" />
                    </StackPanel>
                </Grid>
            </StackPanel>

            <!-- Spacer -->
            <Panel Grid.Row="3" />

            <!-- Buttons Section -->
            <Grid Grid.Row="4" ColumnDefinitions="*,12,Auto,8,Auto">
                <TextBlock Name="ErrorText" Grid.Column="0" VerticalAlignment="Center"
                           Foreground="{DynamicResource AccentDangerBrush}" FontSize="12" TextWrapping="Wrap" />

                <Button Name="CancelButton" Grid.Column="2" Content="Отмена"
                        Padding="16,8" CornerRadius="6"
                        Background="{DynamicResource SurfaceCardBrush}"
                        Foreground="{DynamicResource TextPrimaryBrush}"
                        BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" />

                <Button Name="CreateButton" Grid.Column="4" Content="Создать холст"
                        Padding="16,8" CornerRadius="6"
                        Background="{DynamicResource AccentPrimaryBrush}"
                        Foreground="#0A0E17" FontWeight="SemiBold"
                        IsDefault="True" />
            </Grid>
        </Grid>
    </Border>
</Window>
